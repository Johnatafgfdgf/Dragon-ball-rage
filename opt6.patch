index 0000000..bbd4896
--- /dev/null
+++ b/port/src/gs/shaders/fg_proof.comp
@@ -0,0 +1,26 @@
+#version 450
+// Tiny GPU evidence pass: compare 256 RGBA samples of the selected image
+// against the previous submitted image. A difference proves source content
+// changed; equality is conservatively treated as a repeat, never invented FPS.
+layout(local_size_x=16,local_size_y=16) in;
+layout(set=0,binding=0) uniform sampler2D source;
+layout(set=0,binding=1) uniform sampler2D previous;
+layout(set=0,binding=2) uniform sampler2D scene;
+layout(set=1,binding=0,rgba8) uniform writeonly image2D thumbnail;
+layout(set=1,binding=1,rgba16f) uniform writeonly image2D result;
+layout(set=2,binding=0) uniform U {vec2 visible;uint have;uint generated;};
+shared uint different[256];
+void main() {
+ uint i=gl_LocalInvocationIndex;
+ ivec2 p=ivec2(gl_LocalInvocationID.xy);
+ vec2 uv=(vec2(p)+0.5)/16.0;
+ vec4 c=textureLod(source,uv*visible,0.0);
+ // Quantize before comparison: the saved thumbnail is RGBA8.
+ c=floor(clamp(c,0.0,1.0)*255.0+0.5)/255.0;
+ vec4 d=abs(c-texelFetch(previous,p,0));
+ different[i]=(have==0 || any(greaterThan(d,vec4(0.5/255.0))))?1u:0u;
+ imageStore(thumbnail,p,c);
+ barrier();
+ for(uint stride=128;stride>0;stride>>=1){if(i<stride)different[i]|=different[i+stride];barrier();}
+ if(i==0)imageStore(result,ivec2(0),vec4(float(different[0]),generated!=0?texelFetch(scene,ivec2(0),0).g:0.0,float(have),0));
+}
