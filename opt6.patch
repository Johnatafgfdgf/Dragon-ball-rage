diff --git a/port/src/gs/gs_fg_probe.c b/port/src/gs/gs_fg_probe.c
new file mode 100644
index 0000000..c5e4451
--- /dev/null
+++ b/port/src/gs/gs_fg_probe.c
@@ -0,0 +1,140 @@
+/* Optional observation: the game still renders if proof/timer resources fail.
+ * Only eight bytes of verification flags are read AFTER a signalled GPU fence.
+ * No images, gameplay state or interpolation pixels are read back to the CPU. */
+#include "gs_fg_probe.h"
+#include "gs_fg_trace.h"
+#include "gs_perf.h"
+#include <stdio.h>
+#include <string.h>
+#ifndef __APPLE__
+#include "shaders.h"
+#endif
+static SDL_GPUDevice *device;
+static SDL_GPUComputePipeline *proof;
+static SDL_GPUSampler *sampler;
+static SDL_GPUTexture *thumb[2],*flags;
+static struct {SDL_GPUTransferBuffer *buffer;uint64_t id;} pending[32];
+static int current,have,active;
+static uint64_t lastPresent,pacingNs;
+uint64_t GsFg_PacingNs(void) {return pacingNs;}
+uint64_t GsFg_EarliestNs(void) {unsigned hz=GsPerf_RefreshMilliHz();return lastPresent?lastPresent+(hz?1000000000000ull/hz:16666667ull):0;}
+static uint64_t presentId;
+static int64_t presentResult;
+static DrVkProbe probe;
+static void result(uint64_t id) {
+ int found=0;
+ for(int i=0;i<32;i++)if(pending[i].id==id) {
+  found=1;
+  const Uint16 *px=SDL_MapGPUTransferBuffer(device,pending[i].buffer,false);
+  if(px) {
+   /* Half floats produced by the shader are exactly 0 or 1 (0x3c00). */
+   int distinct=px[0]==0x3c00,cut=px[1]==0x3c00;
+   SDL_UnmapGPUTransferBuffer(device,pending[i].buffer);
+   GsFg_Proof(id,px[2]==0x3c00?(distinct|(cut?2:0)):-1);
+  } else GsFg_Proof(id,-1);
+  pending[i].id=0;break;
+ }
+ if(!found)GsFg_Proof(id,-1);
+}
+static void event(void *user,int what,uint64_t id,int64_t value,uint64_t detail) {
+ (void)user;
+ if(what==DR_VK_CAPS){active=!!(value&1);GsFg_Caps((int)value);fprintf(stderr,"bt3: opt6 Vulkan observer active=%d gpu_timestamps=%d GOOGLE_display_timing=%d timestampValidBits=%llu\n",active,!!(value&2),!!(value&4),(unsigned long long)detail);}
+ else if(what==DR_VK_SUBMIT){if(id)GsFg_Event(FG_SUBMIT,id,value,detail);}
+ else if(what==DR_VK_PRESENT){presentId=id;presentResult=value;if(id)GsFg_Event(FG_PRESENT,id,value,detail);}
+ else if(what==DR_VK_SOURCE_DONE)GsFg_Event(FG_SOURCE_COMPLETE,id,value,detail);
+ else if(what==DR_VK_GPU_DONE) {
+  if(value==-2){GsFg_Event(FG_DROP,id,7,detail);for(int i=0;i<32;i++)if(pending[i].id==id)pending[i].id=0;}
+  else {if(detail!=DR_VK_FLOW)result(id);GsFg_Event(FG_COMPLETE,id,value,detail);}
+ } else if(what==DR_VK_DISPLAY)GsFg_Event(FG_DISPLAY,id,value,detail);
+ else if(what==DR_VK_RETIRED)GsFg_Event(FG_DISPLAY,0,-1,id); /* unknown != dropped */
+}
+void GsFg_DeviceProperties(SDL_PropertiesID props) {
+ probe.abi=DR_VK_PROBE_ABI;probe.event=event;
+ SDL_SetPointerProperty(props,DR_VK_PROBE_PROPERTY,&probe);
+}
+static void release_proof(void) {
+ GsFg_ProofReady(0);
+ if(proof)SDL_ReleaseGPUComputePipeline(device,proof);proof=NULL;
+ if(sampler)SDL_ReleaseGPUSampler(device,sampler);sampler=NULL;
+ for(int i=0;i<2;i++){if(thumb[i])SDL_ReleaseGPUTexture(device,thumb[i]);thumb[i]=NULL;}
+ if(flags)SDL_ReleaseGPUTexture(device,flags);flags=NULL;
+ for(int i=0;i<32;i++){if(pending[i].buffer)SDL_ReleaseGPUTransferBuffer(device,pending[i].buffer);pending[i].buffer=NULL;pending[i].id=0;}
+}
+void GsFg_Device(SDL_GPUDevice *dev) {
+ if(device){SDL_WaitForGPUIdle(device);release_proof();}
+ device=dev;have=current=0;
+ if(!dev)return;
+#ifndef __APPLE__
+ if(!active){fprintf(stderr,"bt3: opt6 backend observer missing; present/display counters unavailable\n");return;}
+ SDL_GPUComputePipelineCreateInfo c;SDL_zero(c);
+ c.code=kFg_proofCompSpv;c.code_size=sizeof(kFg_proofCompSpv);c.entrypoint="main";c.format=SDL_GPU_SHADERFORMAT_SPIRV;
+ c.num_samplers=3;c.num_readwrite_storage_textures=2;c.num_uniform_buffers=1;
+ c.threadcount_x=c.threadcount_y=16;c.threadcount_z=1;
+ proof=SDL_CreateGPUComputePipeline(dev,&c);if(!proof)goto fail;
+ SDL_GPUSamplerCreateInfo sc;SDL_zero(sc);sc.min_filter=sc.mag_filter=SDL_GPU_FILTER_NEAREST;
+ sc.address_mode_u=sc.address_mode_v=sc.address_mode_w=SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+ sampler=SDL_CreateGPUSampler(dev,&sc);if(!sampler)goto fail;
+ SDL_GPUTextureCreateInfo t;SDL_zero(t);t.type=SDL_GPU_TEXTURETYPE_2D;
+ t.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER|SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_WRITE;
+ t.width=t.height=16;t.num_levels=t.layer_count_or_depth=1;t.format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+ for(int i=0;i<2;i++){thumb[i]=SDL_CreateGPUTexture(dev,&t);if(!thumb[i])goto fail;}
+ t.width=t.height=1;t.format=SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT;
+ flags=SDL_CreateGPUTexture(dev,&t);if(!flags)goto fail;
+ SDL_GPUTransferBufferCreateInfo b;SDL_zero(b);b.usage=SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD;b.size=8;
+ for(int i=0;i<32;i++){pending[i].buffer=SDL_CreateGPUTransferBuffer(dev,&b);if(!pending[i].buffer)goto fail;}
+ GsFg_ProofReady(1);
+ fprintf(stderr,"bt3: opt6 GPU proof: 256 RGBA samples/image, bounded 32 slots, 8-byte async flags; no CPU pixel readback\n");
+ return;
+fail:
+ fprintf(stderr,"bt3: opt6 image uniqueness unavailable: %s\n",SDL_GetError());release_proof();
+#endif
+}
+void GsFg_InvalidateProof(void) {have=0;}
+void GsFg_Compute(uint64_t id,int kind) {probe.compute=id;probe.computeKind=kind;}
+void GsFg_Verify(SDL_GPUCommandBuffer *cmd,SDL_GPUTexture *image,Uint32 tw,Uint32 th,Uint32 iw,Uint32 ih,uint64_t id,int generated,SDL_GPUTexture *scene) {
+ if(!proof || !image || !tw || !th)return;
+ int slot=-1;for(int i=0;i<32;i++)if(!pending[i].id){slot=i;break;}
+ if(slot<0){GsFg_Proof(id,-1);return;}
+ SDL_GPUTextureSamplerBinding sm[3];SDL_zeroa(sm);
+ sm[0].texture=image;sm[1].texture=thumb[current];sm[2].texture=scene?scene:thumb[current];
+ for(int i=0;i<3;i++)sm[i].sampler=sampler;
+ SDL_GPUStorageTextureReadWriteBinding rw[2];SDL_zeroa(rw);
+ rw[0].texture=thumb[current^1];rw[1].texture=flags;
+ struct {float u,v;Uint32 have,generated;} u={(float)iw/tw,(float)ih/th,(Uint32)have,generated&&scene?1u:0u};
+ GsFg_Compute(id,generated?DR_VK_SYNTH:3);
+ SDL_PushGPUComputeUniformData(cmd,0,&u,sizeof(u));
+ SDL_GPUComputePass *pass=SDL_BeginGPUComputePass(cmd,rw,2,NULL,0);
+ if(!pass){GsFg_Compute(0,0);return;}
+ SDL_BindGPUComputePipeline(pass,proof);SDL_BindGPUComputeSamplers(pass,0,sm,3);
+ SDL_DispatchGPUCompute(pass,1,1,1);SDL_EndGPUComputePass(pass);
+ GsFg_Compute(0,0);
+ SDL_GPUCopyPass *copy=SDL_BeginGPUCopyPass(cmd);
+ SDL_GPUTextureRegion src;SDL_zero(src);src.texture=flags;src.w=src.h=src.d=1;
+ SDL_GPUTextureTransferInfo dst;SDL_zero(dst);dst.transfer_buffer=pending[slot].buffer;
+ SDL_DownloadFromGPUTexture(copy,&src,&dst);SDL_EndGPUCopyPass(copy);
+ pending[slot].id=id;current^=1;have=1;
+}
+int GsFg_Submit(SDL_GPUCommandBuffer *cmd,uint64_t image,uint64_t source) {
+ if(!cmd)return 0;
+ /* At most one selected image per physical display period. This prevents
+    endpoint/next-intermediate bursts. It paces presentation, never simulation
+    steps. The wait is excluded from CPU-work/controller measurements. */
+ int requested,effective,reason;GsPerf_FramegenGet(&requested,&effective,&reason);
+ if(image && requested>1) {
+  unsigned hz=GsPerf_RefreshMilliHz();
+  uint64_t now=SDL_GetTicksNS(),period=hz?1000000000000ull/hz:16666667ull;
+  if(lastPresent && now<lastPresent+period) {
+   uint64_t before=now;SDL_DelayPrecise(lastPresent+period-now);
+   uint64_t slept=SDL_GetTicksNS()-before;pacingNs+=slept;
+   extern int Gs_RenderThreaded(void);extern unsigned long long gPortSleptNs;
+   if(!Gs_RenderThreaded())gPortSleptNs+=slept;
+  }
+ }
+ probe.image=image;probe.source=source;presentId=0;presentResult=-1;
+ int ok=SDL_SubmitGPUCommandBuffer(cmd);
+ probe.image=probe.source=0;
+ if(image && active && (presentId!=image || (presentResult!=0 && presentResult!=1000001003)))ok=0;
+ if(ok && image)lastPresent=SDL_GetTicksNS();
+ if(!ok){have=0;if(image)GsFg_Event(FG_DROP,image,8,0);}
+ return ok;
+}
