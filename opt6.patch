@@ -0,0 +1,34 @@
+#ifndef DR_GS_FG_TRACE_H
+#define DR_GS_FG_TRACE_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum { FG_CAPTURE, FG_HISTORY, FG_DISPATCH, FG_COMPLETE, FG_ENQUEUE,
+       FG_DEQUEUE, FG_COMPOSITE, FG_PRESENT, FG_DROP, FG_DISABLED_REASON,
+       FG_DISPLAY, FG_ROLLBACK, FG_SUBMIT, FG_PROOF, FG_SOURCE_COMPLETE };
+enum { FG_REAL=1, FG_GENERATED=2, FG_FLOW=3 };
+typedef struct GsFgStats {
+    uint64_t real, dispatched, completed, presented, uniquePresented;
+    uint64_t generatedPresented, displayed, dropped, repeats, unknownProof;
+    uint64_t presentFailed, unavailableFeedback, epoch, resimTicks, canceled;
+    uint64_t flowGpuNs, synthGpuNs, lastFlowSource, lastSynthSource;
+    int observer, timing, gpuTimer, proof;
+} GsFgStats;
+uint64_t GsFg_Source(uint64_t now, unsigned blank);
+void GsFg_Register(uint64_t id, uint64_t previous, uint64_t source, int kind, uint64_t due);
+void GsFg_Event(int stage, uint64_t id, int64_t value, uint64_t detail);
+void GsFg_Proof(uint64_t id, int distinct);
+void GsFg_Deadline(uint64_t id,uint64_t due);
+void GsFg_Snapshot(GsFgStats *stats);
+void GsFg_Caps(int flags);
+void GsFg_ProofReady(int ready);
+void GsFg_ResetGpuCosts(uint64_t throughSource);
+void GsFg_Rollback(unsigned depth);
+uint64_t GsFg_Epoch(void);
+void GsFg_ResimTick(void);
+void GsFg_Flush(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
