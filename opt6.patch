+/* Quality is reduced before repeatedly disabling the whole optical path.
+ * Inputs are fenced Vulkan GPU timestamps, not command-recording CPU time. */
+typedef struct DrOpticalQualityPolicy {int requested,quality;unsigned over;uint64_t changed,good;int initialized;} DrOpticalQualityPolicy;
+static inline int DrOpticalQualitySample(DrOpticalQualityPolicy *p,int requested,int adaptive,uint64_t gpuNs,uint64_t tick,uint64_t now) {
+    if(requested<0)requested=0;
+    if(requested>2)requested=2;
+    if(!p->initialized || p->requested!=requested || !adaptive) {
+        p->initialized=1;p->requested=p->quality=requested;p->over=0;p->changed=now;p->good=0;return p->quality;
+    }
+    if(!gpuNs || !tick){p->over=0;p->good=0;return p->quality;}
+    if(now-p->changed<1000000000ull)return p->quality;
+    if(gpuNs>tick*35/100) {
+        p->good=0;
+        if(++p->over>=8 && p->quality>0){p->quality--;p->over=0;p->changed=now;}
+    } else {
+        p->over=0;
+        if(p->quality<requested && gpuNs<tick*15/100) {
+            if(!p->good)p->good=now;
+            if(now-p->good>=15000000000ull && now-p->changed>=30000000000ull){p->quality++;p->changed=now;p->good=0;}
+        } else p->good=0;
+    }
+    return p->quality;
+}
