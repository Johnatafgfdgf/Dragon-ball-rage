+++ b/port/tools/apply_sdl_probe.py
@@ -0,0 +1,13 @@
+#!/usr/bin/env python3
+"""Apply the marked Dragon Rage observer to exactly SDL 3.4.12 source.
+This is a local vendor patch; it is not an SDL upstream contribution."""
+from pathlib import Path
+import hashlib,shutil,subprocess,sys
+root=Path(__file__).resolve().parents[2]
+sdl=Path(sys.argv[1]).resolve()
+p=sdl/'src/gpu/vulkan/SDL_gpu_vulkan.c'
+expected='c1bd7422338abac65a32290e9a235d3484716385eb6e0927f4d87adae0250a0c'
+assert hashlib.sha256(p.read_bytes()).hexdigest()==expected,'Expected pristine SDL 3.4.12 Vulkan backend'
+subprocess.run(['patch','-p1','--batch','--forward','-i',str(root/'port/third_party/sdl-probe/dragonrage-vulkan.patch')],cwd=sdl,check=True)
+shutil.copyfile(root/'port/src/gs/dr_vk_probe.h',p.parent/'dr_vk_probe.h')
+print('Applied Dragon Rage optional Vulkan observer; SDL Zlib notices preserved')
