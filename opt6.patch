diff --git a/port/src/gs/gs_fg_trace.c b/port/src/gs/gs_fg_trace.c
new file mode 100644
index 0000000..d69100d
--- /dev/null
+++ b/port/src/gs/gs_fg_trace.c
@@ -0,0 +1,147 @@
+/* Bounded pipeline ledger. IDs identify images, not ImGui builds or simulation
+ * reruns. GPU completion and successful vkQueuePresentKHR remain independent. */
+#include "gs_fg_trace.h"
+#include <pthread.h>
+#include <time.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+extern int Port_Setting(const char *,int);
+#define RECORDS 1024
+#define EVENTS 8192
+enum { F_DISPATCH=1, F_COMPLETE=2, F_PRESENT=4, F_DROP=8, F_COUNTED=16, F_PROOF=32, F_DISTINCT=64, F_DISPLAY=128, F_FALLBACK=256, F_GENCOMP=512, F_DROPCOUNT=1024, F_UNKNOWN=2048 };
+typedef struct Record { uint64_t id,previous,source,epoch,due; unsigned flags; int kind; } Record;
+typedef struct Event { uint64_t time,id,previous,source,epoch,due,detail,thread; int64_t value; int stage; } Event;
+static Record records[RECORDS];
+static Event events[EVENTS],writing[EVENTS];
+static unsigned head,count;
+static uint64_t serial,lastFlush,clockOffset,ignoreGpuThrough;
+static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t wake=PTHREAD_COND_INITIALIZER;
+static pthread_once_t workerOnce=PTHREAD_ONCE_INIT;
+static int writePending,workerReady;
+static GsFgStats totals;
+static const char *names[]={"FG_CAPTURE","FG_HISTORY","FG_DISPATCH","FG_COMPLETE","FG_ENQUEUE",
+ "FG_DEQUEUE","FG_COMPOSITE","FG_PRESENT","FG_DROP","FG_DISABLED_REASON","FG_DISPLAY",
+ "FG_ROLLBACK","FG_SUBMIT","FG_PROOF","FG_SOURCE_COMPLETE"};
+static uint64_t now_ns(void) { struct timespec ts;clock_gettime(CLOCK_MONOTONIC,&ts);return (uint64_t)ts.tv_sec*1000000000ull+ts.tv_nsec; }
+static Record *record(uint64_t id) { Record *r=&records[id%RECORDS];return r->id==id?r:NULL; }
+static void emit(int stage,uint64_t id,int64_t value,uint64_t detail) {
+ Record *r=id?record(id):NULL;
+ Event *e=&events[head];memset(e,0,sizeof(*e));
+ e->time=now_ns();e->thread=(uint64_t)(uintptr_t)pthread_self();e->id=id;e->stage=stage;e->value=value;e->detail=detail;
+ e->epoch=r?r->epoch:totals.epoch;
+ if(r){e->previous=r->previous;e->source=r->source;e->due=r->due;}
+ head=(head+1)%EVENTS;if(count<EVENTS)count++;
+}
+static void account(Record *r) {
+ if(r && r->kind==FG_GENERATED && (r->flags&F_DROP) && (r->flags&F_COMPLETE) && !(r->flags&F_DROPCOUNT)) {r->flags|=F_DROPCOUNT;totals.dropped++;}
+ if(r && r->kind==FG_GENERATED && (r->flags&F_COMPLETE) && (r->flags&F_PROOF) && !(r->flags&(F_FALLBACK|F_GENCOMP|F_UNKNOWN))) {r->flags|=F_GENCOMP;totals.completed++;}
+ if(!r || (r->flags&F_COUNTED) || !(r->flags&F_PRESENT) || !(r->flags&F_COMPLETE))return;
+ if(!(r->flags&F_PROOF) || (r->flags&F_UNKNOWN))return;
+ r->flags|=F_COUNTED;
+ if(r->flags&F_DISTINCT) {
+  totals.uniquePresented++;
+  if(r->kind==FG_GENERATED && !(r->flags&F_FALLBACK))totals.generatedPresented++;
+ } else totals.repeats++;
+}
+static void *writer(void *unused) {
+ (void)unused;
+ for(;;) {
+  pthread_mutex_lock(&lock);
+  while(!writePending)pthread_cond_wait(&wake,&lock);
+  unsigned n=count,start=(head+EVENTS-count)%EVENTS;
+  for(unsigned i=0;i<n;i++)writing[i]=events[(start+i)%EVENTS];
+  GsFgStats stats=totals;writePending=0;
+  pthread_mutex_unlock(&lock);
+  FILE *f=fopen("bt3_fg_trace.tmp","w");if(!f)continue;
+  fprintf(f,"Dragon Rage opt6 | CLOCK_MONOTONIC ns | bounded last %u/%u events\n",n,EVENTS);
+  fprintf(f,"real_gpu=%llu synth_dispatched=%llu synth_complete=%llu present_ok=%llu unique_source_present_ok=%llu generated_unique_present_ok=%llu display_feedback=%llu drop=%llu repeat=%llu present_fail=%llu proof_unknown=%llu feedback_unknown=%llu rollback_epoch=%llu resim_ticks=%llu scheduled_canceled=%llu observer=%d gpu_timer=%d display_timing=%d\n",
+   (unsigned long long)stats.real,(unsigned long long)stats.dispatched,(unsigned long long)stats.completed,
+   (unsigned long long)stats.presented,(unsigned long long)stats.uniquePresented,(unsigned long long)stats.generatedPresented,
+   (unsigned long long)stats.displayed,(unsigned long long)stats.dropped,(unsigned long long)stats.repeats,
+   (unsigned long long)stats.presentFailed,(unsigned long long)stats.unknownProof,(unsigned long long)stats.unavailableFeedback,
+   (unsigned long long)stats.epoch,(unsigned long long)stats.resimTicks,(unsigned long long)stats.canceled,stats.observer,stats.gpuTimer,stats.timing);
+  fputs("Unique source: GPU thumbnail proves a change from the previous submitted image; not a photon/scanout measurement. Display: driver GOOGLE feedback only; missing feedback is unknown. Complete: signalled GPU fence. value=-1: GPU timer unavailable.\n",f);
+  for(unsigned i=0;i<n;i++) {
+   Event *e=&writing[i];
+   fprintf(f,"%s t_ns=%llu id=%llu prev=%llu source=%llu epoch=%llu due_ns=%llu value=%lld detail=%llu thread=%llu\n",
+    names[e->stage],(unsigned long long)e->time,(unsigned long long)e->id,(unsigned long long)e->previous,
+    (unsigned long long)e->source,(unsigned long long)e->epoch,(unsigned long long)e->due,
+    (long long)e->value,(unsigned long long)e->detail,(unsigned long long)e->thread);
+  }
+  fclose(f);rename("bt3_fg_trace.tmp","bt3_fg_trace.txt");
+ }
+ return NULL;
+}
+static void start_worker(void) { pthread_t t;if(pthread_create(&t,NULL,writer,NULL)==0){pthread_detach(t);workerReady=1;} }
+void GsFg_Flush(void) {
+ pthread_once(&workerOnce,start_worker);
+ if(!workerReady)return;
+ pthread_mutex_lock(&lock);writePending=1;pthread_cond_signal(&wake);pthread_mutex_unlock(&lock);
+}
+uint64_t GsFg_Source(uint64_t now,unsigned blank) {
+ pthread_mutex_lock(&lock);
+ clockOffset=now_ns()-now;
+ uint64_t id=(++serial)*8;
+ Record *r=&records[id%RECORDS];*r=(Record){.id=id,.source=id,.epoch=totals.epoch,.kind=FG_REAL};
+ emit(FG_CAPTURE,id,(int64_t)(now+clockOffset),blank);
+ int flush=!lastFlush || now-lastFlush>=2000000000ull;
+ if(flush)lastFlush=now;
+ pthread_mutex_unlock(&lock);
+ if(flush && Port_Setting("perf_log",1))GsFg_Flush();
+ return id;
+}
+void GsFg_Register(uint64_t id,uint64_t previous,uint64_t source,int kind,uint64_t due) {
+ pthread_mutex_lock(&lock);
+ Record *r=&records[id%RECORDS];
+ if(r->id!=id) *r=(Record){.id=id,.previous=previous,.source=source,.epoch=totals.epoch,.due=due?due+clockOffset:0,.kind=kind};
+ else r->due=due?due+clockOffset:0;
+ emit(FG_HISTORY,id,kind,0);
+ if(kind==FG_GENERATED)emit(FG_ENQUEUE,id,0,0);
+ pthread_mutex_unlock(&lock);
+}
+void GsFg_Event(int stage,uint64_t id,int64_t value,uint64_t detail) {
+ if(stage<0 || stage>FG_SOURCE_COMPLETE)return;
+ pthread_mutex_lock(&lock);
+ Record *r=id?record(id):NULL;
+ if(stage==FG_DISPATCH && r && !(r->flags&F_DISPATCH)) {
+  r->flags|=F_DISPATCH;if(r->kind==FG_GENERATED)totals.dispatched++;
+ } else if(stage==FG_COMPLETE && r && !(r->flags&F_COMPLETE)) {
+  r->flags|=F_COMPLETE;
+  if(r->kind==FG_GENERATED && r->source>ignoreGpuThrough){totals.lastSynthSource=r->source;if(value>=0)totals.synthGpuNs=totals.synthGpuNs?(totals.synthGpuNs*7+(uint64_t)value)/8:(uint64_t)value;}
+  else if(r->kind==FG_FLOW && value>=0 && r->source>ignoreGpuThrough){totals.lastFlowSource=r->source;totals.flowGpuNs=totals.flowGpuNs?(totals.flowGpuNs*7+(uint64_t)value)/8:(uint64_t)value;}
+ } else if(stage==FG_SOURCE_COMPLETE && r && !(r->flags&F_COMPLETE)) { r->flags|=F_COMPLETE;totals.real++; }
+ else if(stage==FG_PRESENT && r) {
+  /* VK_SUCCESS=0 / VK_SUBOPTIMAL_KHR=1000001003 are accepted. SDL also
+     returns true for OUT_OF_DATE/SURFACE_LOST; those are failures here. */
+  if(value==0 || value==1000001003) {if(!(r->flags&F_PRESENT)){r->flags|=F_PRESENT;totals.presented++;}}
+  else totals.presentFailed++;
+ } else if(stage==FG_DISPLAY && r && !(r->flags&F_DISPLAY)) {
+  r->flags|=F_DISPLAY;
+  if(value>0)totals.displayed++;
+  else if(r->kind==FG_GENERATED && !(r->flags&F_DROP)){r->flags|=F_DROP;}
+ } else if(stage==FG_DROP && r && !(r->flags&(F_DROP|F_PRESENT))) { r->flags|=F_DROP;if(r->kind==FG_GENERATED && !(r->flags&F_DISPATCH))totals.canceled++; }
+ if(stage==FG_DISPLAY && !r)totals.unavailableFeedback++;
+ emit(stage,id,value,detail);account(r);
+ pthread_mutex_unlock(&lock);
+}
+void GsFg_Proof(uint64_t id,int distinct) {
+ pthread_mutex_lock(&lock);Record *r=record(id);
+ if(r && !(r->flags&F_PROOF)) {
+  r->flags|=F_PROOF;if(distinct>=0 && (distinct&1))r->flags|=F_DISTINCT;if(distinct>=0 && (distinct&2))r->flags|=F_FALLBACK;
+  if(distinct<0){totals.unknownProof++;r->flags|=F_UNKNOWN;}
+  emit(FG_PROOF,id,distinct,256);account(r);
+ }
+ pthread_mutex_unlock(&lock);
+}
+void GsFg_Caps(int flags) {pthread_mutex_lock(&lock);totals.observer=!!(flags&1);totals.gpuTimer=!!(flags&2);totals.timing=!!(flags&4);pthread_mutex_unlock(&lock);}
+void GsFg_Snapshot(GsFgStats *s) {pthread_mutex_lock(&lock);*s=totals;pthread_mutex_unlock(&lock);}
+void GsFg_Rollback(unsigned depth) {pthread_mutex_lock(&lock);totals.epoch++;emit(FG_ROLLBACK,0,depth,0);pthread_mutex_unlock(&lock);}
+uint64_t GsFg_Epoch(void) {pthread_mutex_lock(&lock);uint64_t e=totals.epoch;pthread_mutex_unlock(&lock);return e;}
+void GsFg_ResimTick(void) {pthread_mutex_lock(&lock);totals.resimTicks++;pthread_mutex_unlock(&lock);}
+
+void GsFg_Deadline(uint64_t id,uint64_t due) {pthread_mutex_lock(&lock);Record *r=record(id);if(r)r->due=due?due+clockOffset:0;pthread_mutex_unlock(&lock);}
+
+void GsFg_ProofReady(int ready) {pthread_mutex_lock(&lock);totals.proof=ready;pthread_mutex_unlock(&lock);}
+void GsFg_ResetGpuCosts(uint64_t source) {pthread_mutex_lock(&lock);ignoreGpuThrough=source;totals.flowGpuNs=totals.synthGpuNs=totals.lastFlowSource=totals.lastSynthSource=0;pthread_mutex_unlock(&lock);}
