+++ b/port/src/gs/dr_vk_probe.h
@@ -0,0 +1,19 @@
+/* Dragon Rage optional SDL Vulkan observer ABI, shared by engine and patched SDL.
+ * No Vulkan handles cross this boundary. Unmodified SDL safely ignores the property. */
+#ifndef DR_VK_PROBE_H
+#define DR_VK_PROBE_H
+#include <stdint.h>
+#define DR_VK_PROBE_ABI 0x44520601u
+#define DR_VK_PROBE_PROPERTY "dragonrage.vulkan.probe"
+enum { DR_VK_CAPS=1, DR_VK_SUBMIT, DR_VK_PRESENT, DR_VK_GPU_DONE,
+       DR_VK_SOURCE_DONE, DR_VK_DISPLAY, DR_VK_RETIRED };
+enum { DR_VK_FLOW=1, DR_VK_SYNTH=2 };
+typedef struct DrVkProbe {
+    uint32_t abi;
+    /* Set by the render owner only; snapshots belong to each command buffer. */
+    uint64_t image, source, compute;
+    int computeKind;
+    void (*event)(void *user, int event, uint64_t id, int64_t value, uint64_t detail);
+    void *user;
+} DrVkProbe;
+#endif
