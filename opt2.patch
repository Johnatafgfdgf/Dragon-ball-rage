new file mode 100644
index 0000000..d316de2
--- /dev/null
+++ b/port/src/gs/gs_perf.c
@@ -0,0 +1,98 @@
+/* Runtime diagnostics. Source ticks, generated pictures and repeats stay separate. */
+#include "gs_perf.h"
+#include <stdio.h>
+#include <stdlib.h>
+#ifdef __ANDROID__
+#include <unistd.h>
+#endif
+extern int Port_Setting(const char *, int);
+static int sThermal, sPressure;
+static unsigned sRefresh = 60000;
+static int sSourceCap = 4;
+int GsPerf_SourceCap(void) { return __atomic_load_n(&sSourceCap, __ATOMIC_RELAXED); }
+static unsigned sGenerated, sRepeated, sReal;
+
+void GsPerf_SetThermal(int status) {
+    int value = status < 0 ? 0 : status > 6 ? 6 : status;
+    int old = __atomic_exchange_n(&sThermal, value, __ATOMIC_RELAXED);
+    if (old != value) fprintf(stderr, "bt3: opt2 thermal status %d\n", value);
+}
+int GsPerf_Thermal(void) { return __atomic_load_n(&sThermal, __ATOMIC_RELAXED); }
+void GsPerf_SetRefreshMilliHz(int refresh) {
+    if (refresh >= 24000 && refresh <= 1000000)
+        __atomic_store_n(&sRefresh, (unsigned)refresh, __ATOMIC_RELAXED);
+}
+unsigned GsPerf_RefreshMilliHz(void) { return __atomic_load_n(&sRefresh, __ATOMIC_RELAXED); }
+void GsPerf_SetMemoryPressure(int level) {
+    int value = level < 0 ? 0 : level > 2 ? 2 : level;
+    int old = __atomic_load_n(&sPressure, __ATOMIC_RELAXED);
+    /* Hold the smaller budget until the game restarts; avoid immediate regrowth. */
+    while (value > old && !__atomic_compare_exchange_n(&sPressure, &old, value, 0,
+                                                       __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+}
+int GsPerf_MemoryPressure(void) { return __atomic_load_n(&sPressure, __ATOMIC_RELAXED); }
+void GsPerf_Present(char kind) {
+    unsigned *counter = kind == 'B' ? &sGenerated : kind == 'D' ? &sRepeated : &sReal;
+    __atomic_fetch_add(counter, 1u, __ATOMIC_RELAXED);
+}
+static int compare_u64(const void *a, const void *b) {
+    uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+    return (x > y) - (x < y);
+}
+void GsPerf_Tick(uint64_t intervalNs, uint64_t workNs, uint64_t targetNs,
+                 uint64_t gameNs, uint64_t listNs, uint64_t textureNs, uint64_t pipelineNs) {
+    static uint64_t samples[120], elapsed, work, game, list, texture, pipeline, lastTarget;
+    static unsigned count, misses;
+    static unsigned badBudget, goodBudget;
+    /* Whole source-frame work catches overload that submission time alone
+       misses (simulation and an asynchronous GPU queue can also be limiting).
+       This guard runs even when logging is disabled. */
+    if (targetNs && workNs > targetNs + targetNs / 20) {
+        goodBudget = 0;
+        if (++badBudget >= 6) __atomic_store_n(&sSourceCap, 1, __ATOMIC_RELAXED);
+    } else {
+        badBudget = 0;
+        if (++goodBudget >= 120) __atomic_store_n(&sSourceCap, 4, __ATOMIC_RELAXED);
+    }
+    if (!Port_Setting("perf_log", 1)) return;
+    if (!intervalNs || intervalNs > 10000000000ull || targetNs != lastTarget) {
+        if (intervalNs > 10000000000ull)
+            fprintf(stderr, "bt3: opt2 gap: %.1f ms (pause, background or long load)\n", (double)intervalNs / 1e6);
+        count = misses = 0; elapsed = work = game = list = texture = pipeline = 0;
+        lastTarget = targetNs;
+        __atomic_store_n(&sGenerated, 0u, __ATOMIC_RELAXED);
+        __atomic_store_n(&sRepeated, 0u, __ATOMIC_RELAXED);
+        __atomic_store_n(&sReal, 0u, __ATOMIC_RELAXED);
+        return;
+    }
+    samples[count++] = intervalNs;
+    elapsed += intervalNs; work += workNs; game += gameNs; list += listNs;
+    texture += textureNs; pipeline += pipelineNs;
+    misses += intervalNs > targetNs + targetNs / 10;
+    if (count == 120) {
+        unsigned gen = __atomic_exchange_n(&sGenerated, 0u, __ATOMIC_RELAXED);
+        unsigned repeat = __atomic_exchange_n(&sRepeated, 0u, __ATOMIC_RELAXED);
+        unsigned real = __atomic_exchange_n(&sReal, 0u, __ATOMIC_RELAXED);
+        qsort(samples, count, sizeof(samples[0]), compare_u64);
+        fprintf(stderr, "bt3: opt2 perf: %s source %.2f fps, p50 %.2f ms, p95 %.2f ms, p99 %.2f ms, max %.2f ms, late %u/120; "
+                        "real %u generated %u repeated %u; work %.2f game %.2f list %.2f tex %.2f pipe %.2f ms; thermal %d\n",
+                targetNs > 25000000ull ? "fight" : "menu", 120e9 / (double)elapsed,
+                (double)samples[59] / 1e6, (double)samples[113] / 1e6, (double)samples[118] / 1e6,
+                (double)samples[119] / 1e6, misses,
+                real, gen, repeat, (double)work / 120e6, (double)game / 120e6, (double)list / 120e6,
+                (double)texture / 120e6, (double)pipeline / 120e6, GsPerf_Thermal());
+#ifdef __ANDROID__
+        { /* Resident memory includes the CPU/GPU shared mappings; not a GPU timer. */
+            FILE *fp = fopen("/proc/self/statm", "r");
+            unsigned long total, resident;
+            if (fp != NULL) {
+                if (fscanf(fp, "%lu %lu", &total, &resident) == 2)
+                    fprintf(stderr, "bt3: opt2 RSS %.1f MB, memory pressure %d\n",
+                            (double)resident * (double)sysconf(_SC_PAGESIZE) / 1048576.0, GsPerf_MemoryPressure());
+                fclose(fp);
+            }
+        }
+#endif
+        count = misses = 0; elapsed = work = game = list = texture = pipeline = 0;
+    }
+}
