+            unsigned ideal = rate * (multiple ? multiple : 1u);
+            unsigned difference = ideal > refreshMilliHz ? ideal - refreshMilliHz : refreshMilliHz - ideal;
+            if (difference <= refreshMilliHz / 100u) break;
