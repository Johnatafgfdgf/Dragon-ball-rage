+static inline int DrFramegenSteps(int cap, unsigned blanks) {
+    int steps = cap * (int)(blanks < 1 ? 1 : blanks > 2 ? 2 : blanks) / 2;
+    return steps < 1 ? 1 : steps;
+}
+/* Online/game-speed modes can change the source tick rate. Never spend work
+   generating more pictures than the active display can show at that rate. */
+static inline int DrTickDisplaySteps(int wanted, unsigned refreshMilliHz, uint64_t tickNs) {
+    uint64_t fit = ((uint64_t)refreshMilliHz * tickNs + 10000000000ull) / 1000000000000ull;
+    if (fit < 1) fit = 1;
+    return wanted < (int)fit ? wanted : (int)fit;
+}
+/* Fast decrease, three seconds of spare capacity before recovery. A single load
+   does not switch modes; no allocations, sleeps or game-state changes. */
+static inline int DrFramePolicySample(DrFramePolicy *p, uint64_t ns, uint64_t now,
+                                      uint64_t tickNs, int wanted, int thermal, int adaptive) {
+    int limit = wanted < 1 ? 1 : wanted > 4 ? 4 : wanted;
+    if (!p->cap) p->cap = limit;
+    if (thermal >= 3) limit = 1;
+    else if (thermal >= 2 && limit > 2) limit = 2;
+    if (p->cap > limit) { p->cap = limit; p->changedNs = now; p->goodSinceNs = 0; }
+    if (!adaptive) { p->cap = limit; return limit; }
+    if (!ns || !tickNs) { p->slow = 0; p->goodSinceNs = 0; return p->cap; }
+    if (ns > 100000000ull) ns = 100000000ull;
+    p->meanNs = p->meanNs ? (p->meanNs * 7 + ns) / 8 : ns;
+    if (++p->seen < 24) return p->cap;
+    /* VSync blocking is included: a healthy 16.7 ms presentation on a 60 Hz
+       screen must remain eligible for 2x, rather than being misread as overload. */
+    if (p->meanNs * (uint64_t)p->cap > tickNs * 108 / 100) {
+        p->goodSinceNs = 0;
+        if (++p->slow >= 4 && p->cap > 1) {
+            p->cap = p->cap > 2 ? 2 : 1;
+            p->changedNs = now; p->slow = 0;
+        }
+    } else {
+        int next = p->cap == 1 ? 2 : limit;
+        p->slow = 0;
+        if (next > p->cap && next <= limit && p->meanNs * (uint64_t)next < tickNs * 65 / 100) {
+            if (!p->goodSinceNs) p->goodSinceNs = now;
+            if (now - p->goodSinceNs >= 3000000000ull && now - p->changedNs >= 3000000000ull) {
+                p->cap = next; p->changedNs = now; p->goodSinceNs = 0;
+            }
+        } else p->goodSinceNs = 0;
+    }
+    return p->cap;
+}
+static inline size_t DrCacheLimit(size_t base, int pressure) {
+    return pressure >= 2 ? base / 2 : pressure == 1 ? base / 4 * 3 : base;
+}
