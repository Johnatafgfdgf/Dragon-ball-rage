new file mode 100644
index 0000000..2ded1a7
--- /dev/null
+++ b/port/src/gs/gs_perf.h
@@ -0,0 +1,117 @@
+/* Dragon Rage opt2: deterministic performance policies, independent of Android/SDL. */
+#ifndef DR_GS_PERF_H
+#define DR_GS_PERF_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+
+/* All-or-nothing allocation of interpolation history. */
+static inline int DrAllocGroup(void **blocks, const size_t *sizes, size_t count,
+                                void *(*allocate)(size_t), void (*release)(void *)) {
+    size_t i;
+    for (i = 0; i < count; i++) {
+        blocks[i] = allocate(sizes[i]);
+        if (blocks[i] == NULL) {
+            while (i > 0) { i--; release(blocks[i]); blocks[i] = NULL; }
+            return 0;
+        }
+    }
+    return 1;
+}
+
+typedef struct DrFramePolicy {
+    uint64_t meanNs, changedNs, goodSinceNs;
+    unsigned slow, seen;
+    int cap;
+} DrFramePolicy;
+
+/* Values 0..3 remain compatible with upstream: legacy 240 is restricted to 4x.
+   Value 4 adds 3x without reinterpreting an existing settings file. */
+static inline int DrFramegenMultiplier(int setting) {
+    return setting <= 0 ? 1 : setting == 1 ? 2 : setting == 4 ? 3 : 4;
+}
+static inline int DrDisplayCap(int wanted, unsigned refreshMilliHz) {
+    unsigned cap = refreshMilliHz ? (refreshMilliHz + 1000u) / 30000u : 2u;
+    if (cap < 1u) cap = 1u;
+    if (cap > 4u) cap = 4u;
+    if (wanted < (int)cap) cap = (unsigned)wanted;
