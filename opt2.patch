diff --git a/port/src/port_pacing.h b/port/src/port_pacing.h
new file mode 100644
index 0000000..fddcb7f
--- /dev/null
+++ b/port/src/port_pacing.h
@@ -0,0 +1,13 @@
+/* Sleep to the same monotonic deadline after a signal interrupts the wait.
+   No spinning, timer-slack override, clock forcing or change to game speed. */
+#ifndef DR_PORT_PACING_H
+#define DR_PORT_PACING_H
+#include <errno.h>
+#include <time.h>
+static inline void DrPaceSleepUntil(unsigned long long deadlineNs) {
+    struct timespec due;
+    due.tv_sec = (time_t)(deadlineNs / 1000000000ull);
+    due.tv_nsec = (long)(deadlineNs % 1000000000ull);
+    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &due, NULL) == EINTR) {}
+}
+#endif
