@@ -0,0 +1,68 @@
+#version 450
+// Mobile optical flow derived from Win-FG model 4 (MIT); see third_party/win-fg.
+// Cache each 5x5 source patch once per direction, retaining the exhaustive 7x7
+// scan, independent zero hypothesis and subpixel fit at a smaller flow grid.
+layout(local_size_x=8,local_size_y=8) in;
+layout(set=2,binding=0) uniform U { float fullWidth;float fullHeight;uint level;uint finest; };
+layout(set=0,binding=0) uniform sampler2D uLumaPrev;
+layout(set=0,binding=1) uniform sampler2D uLumaCurr;
+layout(set=0,binding=2) uniform sampler2D uPredictor;
+layout(set=1,binding=0,rgba16f) uniform writeonly image2D uFlow;
+vec2 uv,invLuma;
+float refPatch[25];
+void referencePatch(sampler2D a) {
+    // Literal indices allow a mobile compiler to keep the patch in registers.
+#define REF(I,X,Y) refPatch[I]=textureLod(a,uv+vec2(X,Y)*invLuma,0).r
+    REF(0,-2,-2);REF(1,-1,-2);REF(2,0,-2);REF(3,1,-2);REF(4,2,-2);
+    REF(5,-2,-1);REF(6,-1,-1);REF(7,0,-1);REF(8,1,-1);REF(9,2,-1);
+    REF(10,-2,0);REF(11,-1,0);REF(12,0,0);REF(13,1,0);REF(14,2,0);
+    REF(15,-2,1);REF(16,-1,1);REF(17,0,1);REF(18,1,1);REF(19,2,1);
+    REF(20,-2,2);REF(21,-1,2);REF(22,0,2);REF(23,1,2);REF(24,2,2);
+#undef REF
+}
+float sad(sampler2D b,vec2 d) {
+#define TAP(I,X,Y) abs(refPatch[I]-textureLod(b,uv+(vec2(X,Y)+d)*invLuma,0).r)
+    return TAP(0,-2,-2)+TAP(1,-1,-2)+TAP(2,0,-2)+TAP(3,1,-2)+TAP(4,2,-2)
+         + TAP(5,-2,-1)+TAP(6,-1,-1)+TAP(7,0,-1)+TAP(8,1,-1)+TAP(9,2,-1)
+         + TAP(10,-2,0)+TAP(11,-1,0)+TAP(12,0,0)+TAP(13,1,0)+TAP(14,2,0)
+         + TAP(15,-2,1)+TAP(16,-1,1)+TAP(17,0,1)+TAP(18,1,1)+TAP(19,2,1)
+         + TAP(20,-2,2)+TAP(21,-1,2)+TAP(22,0,2)+TAP(23,1,2)+TAP(24,2,2);
+#undef TAP
+}
+vec2 search(sampler2D b,vec2 pred) {
+    vec2 best=pred;
+    float bestCost=3.402823466e+38;
+        for(int y=-3;y<=3;++y)for(int x=-3;x<=3;++x) {
+            vec2 d=pred+vec2(x,y);
+            float cost=sad(b,d)+0.002*dot(abs(d-pred),vec2(1));
+            if(cost<bestCost) {bestCost=cost;best=d;}
+        }
+    return best;
+}
+vec2 solve(sampler2D a,sampler2D b,vec2 pred) {
+    referencePatch(a);
+    vec2 best=search(b,pred);
+    if(length(pred)>1) {
+        vec2 fresh=search(b,vec2(0));
+        if(sad(b,fresh)<sad(b,best))best=fresh;
+    }
+    if(level==finest) {
+        float c=sad(b,best),xm=sad(b,best+vec2(-1,0)),xp=sad(b,best+vec2(1,0));
+        float ym=sad(b,best+vec2(0,-1)),yp=sad(b,best+vec2(0,1));
+        float dx=xm-2*c+xp,dy=ym-2*c+yp;
+        best+=vec2(dx>1e-6?clamp(0.5*(xm-xp)/dx,-0.5,0.5):0,
+                   dy>1e-6?clamp(0.5*(ym-yp)/dy,-0.5,0.5):0);
+    }
+    return best;
+}
+void main() {
+    ivec2 gid=ivec2(gl_GlobalInvocationID.xy),dim=imageSize(uFlow);
+    if(any(greaterThanEqual(gid,dim)))return;
+    uv=(vec2(gid)+0.5)/vec2(dim);
+    invLuma=1.0/vec2(textureSize(uLumaCurr,0));
+    vec2 toLevel=vec2(textureSize(uLumaCurr,0))/vec2(fullWidth,fullHeight);
+    vec4 pred=textureLod(uPredictor,uv,0);
+    vec2 fwd=solve(uLumaPrev,uLumaCurr,pred.xy*toLevel);
+    vec2 bwd=solve(uLumaCurr,uLumaPrev,pred.zw*toLevel);
+    imageStore(uFlow,gid,vec4(fwd/toLevel,bwd/toLevel));
+}
