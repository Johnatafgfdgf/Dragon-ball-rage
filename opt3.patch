diff --git a/port/src/gs/gs_optical.c b/port/src/gs/gs_optical.c
new file mode 100644
index 0000000..751a56b
--- /dev/null
+++ b/port/src/gs/gs_optical.c
@@ -0,0 +1,195 @@
+/* SDL_GPU adaptation of Win-FG model 4. See port/third_party/win-fg/NOTICE.md.
+   Dependencies are separated into compute passes: SDL inserts the Vulkan barriers.
+   Histories stay on the same device/queue as the game; no AHB or second device. */
+#include "gs_optical.h"
+#include <stdlib.h>
+#include <string.h>
+#ifndef __APPLE__
+#include "shaders.h"
+#define FG_LEVELS 7
+struct DrOptical {
+    SDL_GPUDevice *dev;
+    SDL_GPUComputePipeline *luma, *down, *flow, *expand, *synth, *scene, *zero;
+    SDL_GPUSampler *linear;
+    SDL_GPUTexture *color[2], *lum[2][FG_LEVELS], *vectors[FG_LEVELS];
+    SDL_GPUTexture *expanded[2], *out, *cut, *seed;
+    Uint32 w, h, finest;
+    Uint64 bytes;
+    int current, have, pair;
+};
+static SDL_GPUComputePipeline *fg_pipe(DrOptical *f, const Uint8 *code, size_t bytes,
+                                      Uint32 samplers, Uint32 outputs, Uint32 uniforms) {
+    SDL_GPUComputePipelineCreateInfo c;
+    SDL_zero(c);
+    c.code = code; c.code_size = bytes; c.entrypoint = "main";
+    c.format = SDL_GPU_SHADERFORMAT_SPIRV;
+    c.num_samplers = samplers; c.num_readwrite_storage_textures = outputs;
+    c.num_uniform_buffers = uniforms;
+    c.threadcount_x = c.threadcount_y = 16; c.threadcount_z = 1;
+    return SDL_CreateGPUComputePipeline(f->dev, &c);
+}
+static SDL_GPUTexture *fg_tex(DrOptical *f, Uint32 w, Uint32 h,
+                              SDL_GPUTextureFormat format, Uint32 bpp, int target) {
+    SDL_GPUTextureCreateInfo c;
+    SDL_zero(c);
+    c.type = SDL_GPU_TEXTURETYPE_2D; c.format = format;
+    c.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_WRITE;
+    if (target) c.usage |= SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    c.width = w; c.height = h; c.layer_count_or_depth = c.num_levels = 1;
+    if (!SDL_GPUTextureSupportsFormat(f->dev, format, c.type, c.usage)) {
+        SDL_SetError("optical flow: unsupported storage texture format %d", (int)format);
+        return NULL;
+    }
+    SDL_GPUTexture *t = SDL_CreateGPUTexture(f->dev, &c);
+    if (t) f->bytes += (Uint64)w * h * bpp;
+    return t;
+}
+static Uint32 fg_dim(Uint32 n, Uint32 level) { n >>= level; return n ? n : 1; }
+static void fg_release_tex(DrOptical *f, SDL_GPUTexture **t) {
+    if (*t) SDL_ReleaseGPUTexture(f->dev, *t);
+    *t = NULL;
+}
+void DrOptical_Destroy(DrOptical *f) {
+    if (!f) return;
+    for (int k = 0; k < 2; ++k) {
+        fg_release_tex(f, &f->color[k]); fg_release_tex(f, &f->expanded[k]);
+        for (int l = 0; l < FG_LEVELS; ++l) fg_release_tex(f, &f->lum[k][l]);
+    }
+    for (int l = 0; l < FG_LEVELS; ++l) fg_release_tex(f, &f->vectors[l]);
+    fg_release_tex(f, &f->out); fg_release_tex(f, &f->cut); fg_release_tex(f, &f->seed);
+    SDL_GPUComputePipeline *p[] = {f->luma, f->down, f->flow, f->expand, f->synth, f->scene, f->zero};
+    for (unsigned i = 0; i < sizeof(p)/sizeof(p[0]); ++i)
+        if (p[i]) SDL_ReleaseGPUComputePipeline(f->dev, p[i]);
+    if (f->linear) SDL_ReleaseGPUSampler(f->dev, f->linear);
+    free(f); /* SDL defers destruction of objects referenced by in-flight submissions. */
+}
+DrOptical *DrOptical_Create(SDL_GPUDevice *dev, int quality) {
+    DrOptical *f = calloc(1, sizeof(*f));
+    if (!f) { SDL_OutOfMemory(); return NULL; }
+    f->dev = dev; f->w = quality >= 2 ? 768 : 512; f->h = f->w * 7 / 8;
+    f->finest = quality <= 0 ? 2 : 1;
+    SDL_GPUSamplerCreateInfo s;
+    SDL_zero(s);
+    s.min_filter = s.mag_filter = SDL_GPU_FILTER_LINEAR;
+    s.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+    s.address_mode_u = s.address_mode_v = s.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    f->linear = SDL_CreateGPUSampler(dev, &s);
+#define PIPE(field, name, samplers, outputs, ubos) \
+    f->field = fg_pipe(f, name, sizeof(name), samplers, outputs, ubos); if (!f->field) goto fail
+    PIPE(luma, kFg_lumaCompSpv, 1, 1, 0);
+    PIPE(down, kFg_downCompSpv, 1, 1, 0);
+    PIPE(flow, kFg_flowCompSpv, 3, 1, 1);
+    PIPE(expand, kFg_expandCompSpv, 1, 2, 1);
+    PIPE(synth, kFg_synthCompSpv, 5, 1, 1);
+    PIPE(scene, kFg_sceneCompSpv, 2, 1, 0);
+    PIPE(zero, kFg_zeroCompSpv, 0, 1, 0);
+#undef PIPE
+    if (!f->linear) goto fail;
+    for (int k = 0; k < 2; ++k) {
+        f->color[k] = fg_tex(f, f->w, f->h, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, 4, 1);
+        f->expanded[k] = fg_tex(f, f->w/2, f->h/2, SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT, 8, 0);
+        if (!f->color[k] || !f->expanded[k]) goto fail;
+        for (Uint32 l = 1; l < FG_LEVELS; ++l) {
+            f->lum[k][l] = fg_tex(f, fg_dim(f->w,l), fg_dim(f->h,l), SDL_GPU_TEXTUREFORMAT_R32_FLOAT, 4, 0);
+            if (!f->lum[k][l]) goto fail;
+        }
+    }
+    for (Uint32 l = f->finest; l < FG_LEVELS; ++l) {
+        f->vectors[l] = fg_tex(f, (fg_dim(f->w,l)+3)/4, (fg_dim(f->h,l)+3)/4,
+                                SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT, 8, 0);
+        if (!f->vectors[l]) goto fail;
+    }
+    f->seed = fg_tex(f, 1, 1, SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT, 8, 0);
+    f->cut = fg_tex(f, 1, 1, SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT, 8, 0);
+    f->out = fg_tex(f, f->w, f->h, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, 4, 0);
+    if (!f->seed || !f->cut || !f->out) goto fail;
+    return f;
+fail:
+    DrOptical_Destroy(f);
+    return NULL;
+}
+/* End each dependent dispatch before the next begins (SDL_GPU synchronization contract). */
+static int fg_run(DrOptical *f, SDL_GPUCommandBuffer *cmd, SDL_GPUComputePipeline *pipeline,
+                   SDL_GPUTexture **inputs, Uint32 n, SDL_GPUTexture **outputs, Uint32 m,
+                   Uint32 w, Uint32 h, const void *u, Uint32 ubytes) {
+    SDL_GPUStorageTextureReadWriteBinding rw[2];
+    SDL_GPUTextureSamplerBinding sm[5];
+    SDL_zeroa(rw); SDL_zeroa(sm);
+    for (Uint32 i = 0; i < m; ++i) rw[i].texture = outputs[i];
+    for (Uint32 i = 0; i < n; ++i) { sm[i].texture = inputs[i]; sm[i].sampler = f->linear; }
+    if (ubytes) SDL_PushGPUComputeUniformData(cmd, 0, u, ubytes);
+    SDL_GPUComputePass *pass = SDL_BeginGPUComputePass(cmd, rw, m, NULL, 0);
+    if (!pass) return 0;
+    SDL_BindGPUComputePipeline(pass, pipeline);
+    if (n) SDL_BindGPUComputeSamplers(pass, 0, sm, n);
+    SDL_DispatchGPUCompute(pass, (w+15)/16, (h+15)/16, 1);
+    SDL_EndGPUComputePass(pass);
+    return 1;
+}
+void DrOptical_Reset(DrOptical *f) { if (f) f->have = f->pair = 0; }
+int DrOptical_Capture(DrOptical *f, SDL_GPUCommandBuffer *cmd, SDL_GPUTexture *source,
+                      Uint32 sourceW, Uint32 sourceH, int generate) {
+    SDL_GPUTexture *in[3], *out[2];
+    if (!f || !cmd || !source || !sourceW || !sourceH) return -1;
+    f->pair = 0; f->current ^= 1;
+    SDL_GPUBlitInfo b;
+    SDL_zero(b);
+    b.source.texture = source; b.source.w = sourceW; b.source.h = sourceH;
+    b.destination.texture = f->color[f->current]; b.destination.w = f->w; b.destination.h = f->h;
+    b.filter = SDL_GPU_FILTER_LINEAR; b.load_op = SDL_GPU_LOADOP_DONT_CARE;
+    SDL_BlitGPUTexture(cmd, &b);
+    int previous = f->current ^ 1;
+    if (!f->have || !generate) { f->have = 1; return 0; }
+    for (int k = 0; k < 2; ++k) {
+        in[0] = f->color[k]; out[0] = f->lum[k][1];
+        if (!fg_run(f, cmd, f->luma, in, 1, out, 1, f->w/2, f->h/2, NULL, 0)) goto fail;
+        for (Uint32 l = 2; l < FG_LEVELS; ++l) {
+            in[0] = f->lum[k][l-1]; out[0] = f->lum[k][l];
+            if (!fg_run(f,cmd,f->down,in,1,out,1,fg_dim(f->w,l),fg_dim(f->h,l),NULL,0)) goto fail;
+        }
+    }
+    in[0] = f->lum[previous][2]; in[1] = f->lum[f->current][2]; out[0] = f->cut;
+    if (!fg_run(f,cmd,f->scene,in,2,out,1,1,1,NULL,0)) goto fail;
+    out[0] = f->seed;
+    if (!fg_run(f,cmd,f->zero,NULL,0,out,1,1,1,NULL,0)) goto fail;
+    for (int l = FG_LEVELS-1; l >= (int)f->finest; --l) {
+        struct { float w,h; Uint32 level,finest; } u = {(float)f->w,(float)f->h,(Uint32)l,f->finest};
+        in[0] = f->lum[previous][l]; in[1] = f->lum[f->current][l];
+        in[2] = l == FG_LEVELS-1 ? f->seed : f->vectors[l+1]; out[0] = f->vectors[l];
+        if (!fg_run(f,cmd,f->flow,in,3,out,1,(fg_dim(f->w,l)+3)/4,(fg_dim(f->h,l)+3)/4,&u,sizeof(u))) goto fail;
+    }
+    { struct { float w,h,lo,hi; } u = {(float)f->w,(float)f->h,0.25f,0.90f};
+      in[0] = f->vectors[f->finest]; out[0] = f->expanded[0]; out[1] = f->expanded[1];
+      if (!fg_run(f,cmd,f->expand,in,1,out,2,f->w/2,f->h/2,&u,sizeof(u))) goto fail; }
+    f->pair = 1;
+    return 1;
+fail:
+    DrOptical_Reset(f);
+    return -1;
+}
+SDL_GPUTexture *DrOptical_Image(DrOptical *f, SDL_GPUCommandBuffer *cmd, float alpha, int hud) {
+    if (!f || !f->have) return NULL;
+    if (!f->pair || alpha >= 1.0f) return f->color[f->current];
+    struct { float scale,alpha,beta,lambda,epsilon,photo,pad0,pad1,hud[4]; } u =
+        {1.0f, alpha < 0 ? 0 : alpha, 4.0f, 0.5f, 0.001f, 8.0f, 0, 0, {0,0,0,0}};
+    if (hud) { u.hud[2] = (float)f->w; u.hud[3] = (float)f->h * 0.18f; }
+    SDL_GPUTexture *in[] = {f->color[f->current^1],f->color[f->current],f->expanded[1],f->expanded[0],f->cut};
+    SDL_GPUTexture *out[] = {f->out};
+    return fg_run(f,cmd,f->synth,in,5,out,1,f->w,f->h,&u,sizeof(u)) ? f->out : NULL;
+}
+Uint32 DrOptical_Width(const DrOptical *f) { return f ? f->w : 0; }
+Uint32 DrOptical_Height(const DrOptical *f) { return f ? f->h : 0; }
+Uint64 DrOptical_Bytes(const DrOptical *f) { return f ? f->bytes : 0; }
+#else
+struct DrOptical { int unused; };
+DrOptical *DrOptical_Create(SDL_GPUDevice *d,int q) { (void)d;(void)q;return NULL; }
+void DrOptical_Destroy(DrOptical *f) { (void)f; }
+void DrOptical_Reset(DrOptical *f) { (void)f; }
+int DrOptical_Capture(DrOptical *f,SDL_GPUCommandBuffer *c,SDL_GPUTexture *t,Uint32 w,Uint32 h,int g) {
+    (void)f;(void)c;(void)t;(void)w;(void)h;(void)g;return -1;
+}
+SDL_GPUTexture *DrOptical_Image(DrOptical *f,SDL_GPUCommandBuffer *c,float a,int h) { (void)f;(void)c;(void)a;(void)h;return NULL; }
+Uint32 DrOptical_Width(const DrOptical *f) { (void)f;return 0; }
+Uint32 DrOptical_Height(const DrOptical *f) { (void)f;return 0; }
+Uint64 DrOptical_Bytes(const DrOptical *f) { (void)f;return 0; }
+#endif
diff --git a/port/src/gs/gs_optical.h b/port/src/gs/gs_optical.h
new file mode 100644
index 0000000..9032cc5
--- /dev/null
