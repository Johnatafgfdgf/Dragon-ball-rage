@@ -0,0 +1,19 @@
+/* GPU image interpolation. No CPU readback in the presentation path. */
+#ifndef DR_GS_OPTICAL_H
+#define DR_GS_OPTICAL_H
+#include <SDL3/SDL.h>
+typedef struct DrOptical DrOptical;
+/* quality: 0=512px/economy, 1=512px/balanced, 2=768px/quality. */
+DrOptical *DrOptical_Create(SDL_GPUDevice *dev, int quality);
+void DrOptical_Destroy(DrOptical *fg);
+void DrOptical_Reset(DrOptical *fg);
+/* Capture the visible source rectangle; compute flow once when generate=true.
+   Returns 1 only if a valid pair was prepared, 0 for warmup/native-only, -1 on error. */
+int DrOptical_Capture(DrOptical *fg, SDL_GPUCommandBuffer *cmd, SDL_GPUTexture *source,
+                      Uint32 sourceW, Uint32 sourceH, int generate);
+/* alpha in (0,1): synthesize; alpha>=1: current real image. */
+SDL_GPUTexture *DrOptical_Image(DrOptical *fg, SDL_GPUCommandBuffer *cmd, float alpha, int hud);
+Uint32 DrOptical_Width(const DrOptical *fg);
+Uint32 DrOptical_Height(const DrOptical *fg);
+Uint64 DrOptical_Bytes(const DrOptical *fg);
+#endif
diff --git a/port/src/gs/shaders/fg_down.comp b/port/src/gs/shaders/fg_down.comp
new file mode 100644
index 0000000..37cd341
--- /dev/null
+++ b/port/src/gs/shaders/fg_down.comp
@@ -0,0 +1,35 @@
+#version 450
+// Dragon Rage SDL_GPU adaptation of Win-FG fbc69ed6 (MIT); see third_party/win-fg.
+// ─────────────────────────────────────────────────────────────────────────────
+// win-fg model 3 — FSR3 Optical Flow (pass 2/4): luma pyramid downsample.
+//
+// Adapted from AMD FidelityFX-SDK FSR3 Optical Flow luminance-pyramid pass:
+//   ffx_opticalflow_compute_luminance_pyramid.h  (SpdReduce4 == 0.25 box filter,
+//   6 mip levels). FidelityFX SDK is MIT-licensed; see NOTICE.
+//
+// DEVIATION: the SDK builds the whole mip chain in one SPD dispatch using
+// groupshared + atomic workgroup counters. Turnip / Vulkan 1.1 without the SPD
+// library is more robust with one explicit 2x2 box-reduce dispatch per level,
+// which is what this shader does (mathematically identical 4-tap average).
+// ─────────────────────────────────────────────────────────────────────────────
+layout(local_size_x = 16, local_size_y = 16) in;
+
+layout(set = 0, binding = 0) uniform sampler2D uSrc;             // luma level i   (R32F)
+layout(set = 1, binding = 0, r32f) uniform writeonly image2D uDst; // luma level i+1 (R32F)
+
+void main() {
+    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 dim = imageSize(uDst);
+    if (gid.x >= dim.x || gid.y >= dim.y) return;
+
+    // Sample the 4 source texels covering this destination texel (box filter).
+    vec2 srcDim = vec2(textureSize(uSrc, 0));
+    vec2 base = (vec2(gid) * 2.0 + 1.0) / srcDim; // centre of the 2x2 footprint
+    vec2 h = 0.5 / srcDim;
+    float a = textureLod(uSrc, base + vec2(-h.x, -h.y), 0.0).r;
+    float b = textureLod(uSrc, base + vec2( h.x, -h.y), 0.0).r;
+    float c = textureLod(uSrc, base + vec2(-h.x,  h.y), 0.0).r;
+    float d = textureLod(uSrc, base + vec2( h.x,  h.y), 0.0).r;
+
+    imageStore(uDst, gid, vec4((a + b + c + d) * 0.25, 0.0, 0.0, 0.0));
+}
diff --git a/port/src/gs/shaders/fg_expand.comp b/port/src/gs/shaders/fg_expand.comp
new file mode 100644
index 0000000..687f54c
--- /dev/null
+++ b/port/src/gs/shaders/fg_expand.comp
@@ -0,0 +1,94 @@
+#version 450
+// Dragon Rage SDL_GPU adaptation of Win-FG fbc69ed6 (MIT); see third_party/win-fg.
+// ─────────────────────────────────────────────────────────────────────────────
+// win-fg model 4 — FSR3 Optical Flow v2 (pass 4/4): scale to full res + fwd/bwd.
+//
+// Adapted from AMD FidelityFX-SDK FSR3 Optical Flow scale pass:
+//   ffx_opticalflow_scale_optical_flow_advanced_v5.h (bilinear upscale of the
+//   coarse flow field to display resolution). FidelityFX SDK is MIT-licensed.
+//
+// Produces the two full-resolution flow images win-fg's synthesis pass
+// (wfg_synth) consumes as flowExpA / flowExpB.
+//
+// ── Model 4: consistency gating replaces backward = -forward ─────────────────
+// of3_flow now solves the backward field independently (.zw) instead of
+// mirroring the forward one. Where the two fields genuinely describe the same
+// motion they should very nearly cancel: fwd + bwd ~= 0. Where they do NOT
+// cancel, one of the two searches matched something that is not present in both
+// frames — i.e. a disocclusion (background revealed from behind a moving
+// object), an occlusion, or a scene cut where neither search means anything.
+//
+// FSR3 resolves those regions using the game's motion vectors. Colour-only, we
+// have no such fallback, so we do the next-best thing: attenuate the flow
+// toward zero as the two fields disagree. Zero flow makes the downstream
+// warp/blend degenerate into a straight cross-fade, which is soft but correct,
+// instead of confidently warping with a vector that is simply wrong. A hard cut
+// attenuates everywhere and so cross-fades — which is also why model 4 needs
+// no separate scene-change detection pass.
+//
+// The per-frame blend alpha and flowScale are still applied downstream by the
+// synth UBO exactly as in model 0.
+// ─────────────────────────────────────────────────────────────────────────────
+layout(local_size_x = 16, local_size_y = 16) in;
+
+layout(set = 2, binding = 0) uniform U {
+    float fullWidth; float fullHeight; float occlLo; float occlHi;
+};
+
+layout(set = 0, binding = 0) uniform sampler2D uFlowFine;             // finest solved flow (.xy fwd, .zw bwd), residual
+layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D uFwd; // -> flowExpA_
+layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D uBwd; // -> flowExpB_
+
+// Median-of-5 via sorting network — 9 min/max. Strips isolated outlier flow
+// vectors before upscale (same rationale as of3_expand's medianized version).
+float med5(float a, float b, float c, float d, float e) {
+    float x, y;
+    x = min(a,b); a = max(a,b); b = x;
+    x = min(c,d); c = max(c,d); d = x;
+    x = min(a,c); a = max(a,c); c = x;
+    x = min(b,d); b = max(b,d); d = x;
+    x = min(b,c); b = max(b,c); c = x;
+    y = min(b, e); x = max(b, e);
+    return min(max(y, c), x);
+}
+
+void main() {
+    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 dim = imageSize(uFwd);
+    if (gid.x >= dim.x || gid.y >= dim.y) return;
+
+    vec2 uv = (vec2(gid) + 0.5) / vec2(dim);
+
+    // 5-tap median cross on the input flow field (offset = one input-texel).
+    // Applied per-component to .xy (fwd) and .zw (bwd) independently — kills
+    // speckle outliers on both directions before consistency gating below.
+    vec2 fs = 1.0 / vec2(textureSize(uFlowFine, 0));
+    vec4 c4 = textureLod(uFlowFine, uv,                    0.0);
+    vec4 xm = textureLod(uFlowFine, uv - vec2(fs.x, 0.0), 0.0);
+    vec4 xp = textureLod(uFlowFine, uv + vec2(fs.x, 0.0), 0.0);
+    vec4 ym = textureLod(uFlowFine, uv - vec2(0.0, fs.y), 0.0);
+    vec4 yp = textureLod(uFlowFine, uv + vec2(0.0, fs.y), 0.0);
+    vec4 f  = vec4(
+        med5(c4.x, xm.x, xp.x, ym.x, yp.x),
+        med5(c4.y, xm.y, xp.y, ym.y, yp.y),
+        med5(c4.z, xm.z, xp.z, ym.z, yp.z),
+        med5(c4.w, xm.w, xp.w, ym.w, yp.w));
+    vec2 fwd = f.xy;
+    vec2 bwd = f.zw;
+
+    // Test the inverse at the corresponding endpoint, not at the same pixel.
+    // Vectors remain in full color-image pixels even though outputs are half-res.
+    vec2 invFull = 1.0 / vec2(fullWidth, fullHeight);
+    vec2 fEndpoint = uv + fwd * invFull;
+    vec2 bEndpoint = uv + bwd * invFull;
+    vec2 back = textureLod(uFlowFine, fEndpoint, 0.0).zw;
+    vec2 forward = textureLod(uFlowFine, bEndpoint, 0.0).xy;
+    float cf = 1.0 - smoothstep(occlLo, occlHi,
+        length(fwd + back) / (0.5 * (length(fwd) + length(back)) + 0.5));
+    float cb = 1.0 - smoothstep(occlLo, occlHi,
+        length(bwd + forward) / (0.5 * (length(bwd) + length(forward)) + 0.5));
+    if (any(lessThan(fEndpoint,vec2(0))) || any(greaterThan(fEndpoint,vec2(1)))) cf=0;
+    if (any(lessThan(bEndpoint,vec2(0))) || any(greaterThan(bEndpoint,vec2(1)))) cb=0;
+    imageStore(uFwd, gid, vec4(fwd, 0.0, cf));
+    imageStore(uBwd, gid, vec4(bwd, 0.0, cb));
+}
diff --git a/port/src/gs/shaders/fg_flow.comp b/port/src/gs/shaders/fg_flow.comp
new file mode 100644
index 0000000..9a9ae85
--- /dev/null
+++ b/port/src/gs/shaders/fg_flow.comp
@@ -0,0 +1,150 @@
+#version 450
+// Dragon Rage SDL_GPU adaptation of Win-FG fbc69ed6 (MIT); see third_party/win-fg.
+// ─────────────────────────────────────────────────────────────────────────────
+// win-fg model 4 — FSR3 Optical Flow v2 (pass 3/4): coarse-to-fine block flow.
+//
+// Adapted from AMD FidelityFX-SDK FSR3 Optical Flow search pass:
+//   ffx_opticalflow_compute_optical_flow_v5.h
+//   (SAD block-matching, BlockSize 8, SearchRadius 8, prediction from the
+//    previous coarser pyramid level). FidelityFX SDK is MIT-licensed; see NOTICE.
+//
+// This is a self-contained, subgroup-free re-implementation of that pass so it
+// compiles with glslangValidator for Vulkan 1.1 / Turnip. The SDK version uses
+// wave intrinsics (ffxWaveSum), groupshared SAD maps, msad4 and packed-uint
+// luma — none of which are portable to bare GLSL on Adreno.
+//
+// ── Model 4 vs model 3 ────────────────────────────────────────────────────
+//  * BLOCK GRID: one invocation solves one BLOCK x BLOCK block (as the SDK
+//    does) instead of one per pixel. The flow image is 1/BLOCK of the luma
+//    extent at each level; every consumer samples it by normalised uv, so the
+//    coarser grid bilinear-upsamples for free. This is what pays for the rest.
+//  * MATCH WINDOW widened 3x3 -> 5x5 (BR 1 -> 2). A 3x3 window is severely
+//    aperture-limited: on low-contrast or edge-dominated blocks it locks onto
+//    the wrong candidate. This is the main accuracy fix.
+//  * SUB-PIXEL refinement: parabola fit through the SAD either side of the
+//    integer winner, per axis. Without it slow pans quantise to whole texels
+//    and the interpolated frame judders.
+//  * TRUE BIDIRECTIONAL flow: forward (prev matched into curr) is packed in .xy
+//    and a second, independently searched backward field in .zw. Model 3
+//    assumes backward = -forward, which is wrong exactly at occlusion
+//    boundaries. of3_expand_m4 consumes both and uses their disagreement as a
+//    confidence signal.
+//
+// Net cost is ~2.7x LOWER than the per-pixel 3x3/+-3 version despite searching
+// in both directions with a 25-tap window, because the block grid removes 16x
+// the invocations.
+//
+// Flow vectors are carried in FULL-RESOLUTION pixel units across all levels so
+// the predictor needs no rescale between levels.
+// ─────────────────────────────────────────────────────────────────────────────
+layout(local_size_x = 16, local_size_y = 16) in;
+
+layout(set = 2, binding = 0) uniform U {
+    float fullWidth; float fullHeight;
+    uint level; uint finest;
+};
+
+layout(set = 0, binding = 0) uniform sampler2D uLumaPrev;  // prev luma at this level (R32F)
+layout(set = 0, binding = 1) uniform sampler2D uLumaCurr;  // curr luma at this level (R32F)
+layout(set = 0, binding = 2) uniform sampler2D uPredictor; // coarser flow, full-res px (.xy fwd, .zw bwd)
+
+layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D uFlow; // .xy fwd, .zw bwd (full-res px)
+
+const int BR = 2; // 5x5 support disambiguates edges and small repeated textures.
+const int SR = 3; // search radius      -> (2*SR+1)^2 = 49 candidates per level
+
+// Coarse-to-fine reach over 5 levels is +-SR*(1+2+4+8+16) = +-93 full-res px, so
+// the range given up by keeping SR small is recovered by the predictor chain.
+// BR/SR remain the device tuning knobs: raise for quality, lower for speed.
+
+vec2 gUv;       // block centre, normalised
+vec2 gInvLuma;  // one luma texel of THIS level, in uv (NOT the flow grid step)
+
+// SAD of the window around gUv in `a` against `b` displaced by `cand`
+// (cand in this level's luma texels).
+float blockSad(sampler2D a, sampler2D b, vec2 cand) {
+    float sad = 0.0;
+    for (int by = -BR; by <= BR; ++by) {
+        for (int bx = -BR; bx <= BR; ++bx) {
+            vec2 bo = vec2(float(bx), float(by));
+            float pa = textureLod(a, gUv + bo * gInvLuma, 0.0).r;
+            float pb = textureLod(b, gUv + (bo + cand) * gInvLuma, 0.0).r;
+            sad += abs(pa - pb);
+        }
+    }
+    return sad;
+}
+
+// Exhaustive +-SR search then sub-pixel refine. `pred` is in this level's texels.
+vec2 solve(sampler2D a, sampler2D b, vec2 pred) {
+    float bestSad  = 3.402823466e+38;
+    vec2  bestDisp = pred;
+
+    for (int sy = -SR; sy <= SR; ++sy) {
+        for (int sx = -SR; sx <= SR; ++sx) {
+            vec2 cand = pred + vec2(float(sx), float(sy));
+            float sad = blockSad(a, b, cand);
+            // Mild bias toward the predictor (smoothness prior, like the SDK's
+            // prediction term) so textureless blocks keep the coarse flow.
+            sad += 0.002 * (abs(float(sx)) + abs(float(sy)));
+            if (sad < bestSad) {
+                bestSad  = sad;
+                bestDisp = cand;
+            }
+        }
+    }
+
+    // Sub-pixel refinement at level 0 only. Parabola fit on the 5-cell cross of
+    // SAD values around the integer winner in each axis (Lowe 2004 §5, RAFT
+    // arxiv:2003.12039 §3.2 lookup). 4 extra block-SADs — negligible vs the
+    // SR^2 loop and only fires once per direction at the finest pyramid level.
+    // Delta clamped to +-0.5 so a degenerate fit stays in-cell.
+    // Trades a small perf hit for measurably crisper synth on smooth pans.
+    if (level == finest) {
+        float sadC  = blockSad(a, b, bestDisp); // includes the smoothness bias; ratio cancels
+        float sadXm = blockSad(a, b, bestDisp + vec2(-1.0, 0.0));
+        float sadXp = blockSad(a, b, bestDisp + vec2(+1.0, 0.0));
+        float sadYm = blockSad(a, b, bestDisp + vec2(0.0, -1.0));
+        float sadYp = blockSad(a, b, bestDisp + vec2(0.0, +1.0));
+        float dx = 0.0, dy = 0.0;
+        float denomX = sadXm - 2.0 * sadC + sadXp;
+        float denomY = sadYm - 2.0 * sadC + sadYp;
+        if (denomX > 1e-6) dx = clamp(0.5 * (sadXm - sadXp) / denomX, -0.5, 0.5);
+        if (denomY > 1e-6) dy = clamp(0.5 * (sadYm - sadYp) / denomY, -0.5, 0.5);
+        bestDisp += vec2(dx, dy);
+    }
+    return bestDisp;
+}
+
+void main() {
+    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 dim = imageSize(uFlow);   // block grid = ceil(luma extent / BLOCK)
+    if (gid.x >= dim.x || gid.y >= dim.y) return;
+
+    gUv      = (vec2(gid) + 0.5) / vec2(dim);
+    gInvLuma = 1.0 / vec2(textureSize(uLumaCurr, 0));
+
+    // Predictor flow is stored in full-res pixels; convert to this level's texels.
+    vec2 toLevel = vec2(textureSize(uLumaCurr, 0)) / vec2(fullWidth, fullHeight);
+    vec4  pred    = textureLod(uPredictor, gUv, 0.0);
+
+    // Forward: prev block matched into curr. Backward: the reverse, searched
+    // independently — where the two disagree, something was occluded or revealed.
+    vec2 fwd = solve(uLumaPrev, uLumaCurr, pred.xy * toLevel);
+    vec2 bwd = solve(uLumaCurr, uLumaPrev, pred.zw * toLevel);
+
+    // A coarse level can alias or lose detail. Keep an independent zero-centred
+    // hypothesis so one wrong coarse match cannot trap every finer level in a
+    // distant local minimum. Compare actual photometric costs, not vector size.
+    if (length(pred.xy * toLevel) > 1.0) {
+        vec2 fresh = solve(uLumaPrev, uLumaCurr, vec2(0));
+        if (blockSad(uLumaPrev,uLumaCurr,fresh) < blockSad(uLumaPrev,uLumaCurr,fwd)) fwd=fresh;
+    }
+    if (length(pred.zw * toLevel) > 1.0) {
+        vec2 fresh = solve(uLumaCurr, uLumaPrev, vec2(0));
+        if (blockSad(uLumaCurr,uLumaPrev,fresh) < blockSad(uLumaCurr,uLumaPrev,bwd)) bwd=fresh;
+    }
+
+    vec2 toFull = 1.0 / toLevel;
+    imageStore(uFlow, gid, vec4(fwd * toFull, bwd * toFull));
+}
diff --git a/port/src/gs/shaders/fg_luma.comp b/port/src/gs/shaders/fg_luma.comp
new file mode 100644
index 0000000..628fcbd
--- /dev/null
+++ b/port/src/gs/shaders/fg_luma.comp
@@ -0,0 +1,34 @@
+#version 450
+// Dragon Rage SDL_GPU adaptation of Win-FG fbc69ed6 (MIT); see third_party/win-fg.
+// ─────────────────────────────────────────────────────────────────────────────
+// win-fg model 3 — FSR3 Optical Flow (pass 1/4): perceptual luma extract.
+//
+// Adapted from AMD FidelityFX-SDK FSR3 Optical Flow "PrepareLuma" pass:
+//   Kits/FidelityFX/framegeneration/fsr3/include/gpu/opticalflow/
+//       ffx_opticalflow_prepare_luma.h  (LinearLdrToLuminance, Rec709 weights)
+//
+// FidelityFX SDK is MIT-licensed (Copyright (C) Advanced Micro Devices, Inc.).
+// See NOTICE_FIDELITYFX_OPTICALFLOW.md for the full license text.
+//
+// DEVIATION (color-only layer): the layer only sees the final LDR backbuffer
+// color (no HDR transfer-function / MinMaxLuminance metadata, no PQ/scRGB), so
+// we always take the LDR Rec.709 luma branch and skip the HDR perceptual-luma
+// reconstruction the SDK does for transfer functions 1/2.
+// ─────────────────────────────────────────────────────────────────────────────
+layout(local_size_x = 16, local_size_y = 16) in;
+
+layout(set = 0, binding = 0) uniform sampler2D uSrc;          // input color (RGBA8 / AHB)
+layout(set = 1, binding = 0, r32f) uniform writeonly image2D uDst; // perceptual luma (R32F)
+
+void main() {
+    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 dim = imageSize(uDst);
+    if (gid.x >= dim.x || gid.y >= dim.y) return;
+
+    vec2 uv = (vec2(gid) + 0.5) / vec2(dim);
+    vec3 rgb = textureLod(uSrc, uv, 0.0).rgb;
+
+    // FFX LinearLdrToLuminance (Rec.709).
+    float fY = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
+    imageStore(uDst, gid, vec4(fY, 0.0, 0.0, 0.0));
+}
diff --git a/port/src/gs/shaders/fg_scene.comp b/port/src/gs/shaders/fg_scene.comp
new file mode 100644
index 0000000..4252602
--- /dev/null
+++ b/port/src/gs/shaders/fg_scene.comp
@@ -0,0 +1,24 @@
+#version 450
+// One GPU workgroup compares a distributed luminance thumbnail. No CPU wait.
+layout(local_size_x=16,local_size_y=16) in;
+layout(set=0,binding=0) uniform sampler2D prev;
+layout(set=0,binding=1) uniform sampler2D curr;
+layout(set=1,binding=0,rgba16f) uniform writeonly image2D dst;
+shared float diff[256];
+shared float changed[256];
+void main() {
+    uint i=gl_LocalInvocationIndex;
+    vec2 uv=(vec2(gl_LocalInvocationID.xy)+0.5)/16.0;
+    float d=abs(textureLod(prev,uv,0).r-textureLod(curr,uv,0).r);
+    diff[i]=d; changed[i]=d>0.30?1.0:0.0;
+    barrier();
+    for(uint stride=128;stride>0;stride>>=1) {
+        if(i<stride) { diff[i]+=diff[i+stride]; changed[i]+=changed[i+stride]; }
+        barrier();
+    }
+    if(i==0) {
+        float mean=diff[0]/256.0, fraction=changed[0]/256.0;
+        float cut=(mean>0.28 || (mean>0.18 && fraction>0.60))?1.0:0.0;
+        imageStore(dst,ivec2(0),vec4(mean,cut,fraction,0));
+    }
+}
diff --git a/port/src/gs/shaders/fg_synth.comp b/port/src/gs/shaders/fg_synth.comp
new file mode 100644
index 0000000..180f2f5
--- /dev/null
+++ b/port/src/gs/shaders/fg_synth.comp
@@ -0,0 +1,206 @@
+#version 450
+// Dragon Rage SDL_GPU adaptation of Win-FG fbc69ed6 (MIT); see third_party/win-fg.
+// ─────────────────────────────────────────────────────────────────────────────
+// win-fg — interpolated-frame synthesis (models 3 & 4 back end).
+//
+// CLEAN-ROOM STATEMENT
+// Written from first principles for win-fg. It does NOT use, reference, or
+// reimplement the traced bionic-fg / GameScope / Lossless-Scaling synthesis.
+// It contains no learned weights and derives from no third-party compiled
+// artifact. Its math is sourced from the open literature (see ATTRIBUTION),
+// implemented here independently. See docs/PROVENANCE.md.
+//
+// ATTRIBUTION (algorithms, reimplemented from published math — not code):
+//   * Importance-weighted blend of warped candidates ("softmax splatting"):
+//       Niklaus & Liu, "Softmax Splatting for Video Frame Interpolation",
+//       CVPR 2020 (arXiv:2003.05534). We adapt the forward-splat importance
+//       weighting into a scatter-free BACKWARD-warp blend (mobile real-time).
+//   * Brightness-constancy photometric residual:
+//       Horn & Schunck, "Determining Optical Flow", 1981.
+//   * Forward/backward consistency occlusion test:
+//       Sundaram et al. 2010; used e.g. by OCAI (arXiv:2403.18092).
+//   * Dual (prev-side / curr-side) disocclusion fallback concept:
+//       AMD FidelityFX FSR3 Frame Interpolation (MIT), color-only adaptation.
+//
+// MODEL 3 vs 4: identical shader. of3_expand (m3) writes symmetric flow with
+// confidence = 1; of3_expand_m4 writes independently-searched fwd/bwd flow with
+// an occlusion-gated confidence. This pass consumes whatever the front end
+// wrote, so model 4's occlusion behaviour "falls out" of the same math.
+//
+// GEOMETRY / CONVENTIONS
+//   I0 = uPrev (t=0),  I1 = uCurr (t=1),  generated frame at time = alpha.
+//   uFlowFwd = flowExpA = F10 (curr->prev), .xy px, .w conf
+//   uFlowBwd = flowExpB = F01 (prev->curr), .xy px, .w conf
+//   Linear-motion backward warp (one Gauss-Newton-free approximation, standard
+//   for real-time FRUC): the scene point seen at output pixel x came from
+//     I0 at  pA = x - alpha     * F01(x)      (-> alpha=0 gives I0(x))
+//     I1 at  pB = x - (1-alpha) * F10(x)      (-> alpha=1 gives I1(x))
+// ─────────────────────────────────────────────────────────────────────────────
+layout(local_size_x = 16, local_size_y = 16) in;
+
+layout(set = 2, binding = 0) uniform U {
+    float flowScale;   // scales solved flow magnitude (device tuning; 1.0 = as-is)
+    float alpha;       // temporal position of generated frame, 0=prev .. 1=curr
+    float beta;        // softmax sharpness on the importance metric Z
+    float lambda;      // weight of FB-consistency vs photometric term in Z
+    float epsilon;     // floor below which both candidates are "disoccluded"
+    float photoScale;  // scales the photometric residual into Z
+    float pad0; float pad1;
+    vec4  hudRect;     // pixel coords (x0,y0,x1,y1); disabled when x0>=x1.
+                        // fragments inside are written verbatim from uCurr so
+                        // HUD/text doesn't get warped by flow (Isygold pattern).
+};
+
+layout(set = 0, binding = 0) uniform sampler2D uPrev;      // I0
+layout(set = 0, binding = 1) uniform sampler2D uCurr;      // I1
+layout(set = 0, binding = 2) uniform sampler2D uFlowFwd;   // F10 curr->prev (.xy px, .w conf)
+layout(set = 0, binding = 3) uniform sampler2D uFlowBwd;   // F01 prev->curr (.xy px, .w conf)
+
+layout(set = 0, binding = 4) uniform sampler2D uScene;
+
+layout(set = 1, binding = 0, rgba8) uniform writeonly image2D uOut;
+
+const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);    // Rec.709
+float luma(vec3 c) { return dot(c, LUMA); }
+
+void main() {
+    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 dim = imageSize(uOut);
+    if (gid.x >= dim.x || gid.y >= dim.y) return;
+
+    vec2 invDim = 1.0 / vec2(dim);
+    vec2 uv = (vec2(gid) + 0.5) * invDim;
+
+    // A hard cut is a current real image, never a cross-fade between scenes.
+    if (texelFetch(uScene, ivec2(0), 0).g > 0.5) {
+        imageStore(uOut, gid, vec4(textureLod(uCurr,uv,0.0).rgb,1.0));
+        return;
+    }
+
+    // HUD exclusion: if this pixel is inside the host-supplied HUD rect,
+    // write the real current frame verbatim and skip all flow/warp work.
+    // Kills ghosting on text/overlays at the source. 16x16 workgroups are
+    // mostly all-inside or all-outside for any reasonable HUD rect, so the
+    // divergent early-out stays warp-coherent on Adreno.
+    if (hudRect.x < hudRect.z && hudRect.y < hudRect.w
+        && float(gid.x) >= hudRect.x && float(gid.x) < hudRect.z
+        && float(gid.y) >= hudRect.y && float(gid.y) < hudRect.w) {
+        imageStore(uOut, gid, vec4(texture(uCurr, uv).rgb, 1.0));
+        return;
+    }
+
+    // DEBUG flow visualiser: gated on flowScale>5 (an out-of-range sentinel set
+    // live via conf.toml) so we can flip it on/off with no rebuild. When on, the
+    // warp uses fs=1.0 and the generated frame is REPLACED with the raw solved
+    // flow magnitude as brightness (normalised to the 10% clamp): white = flow is
+    // saturating the clamp (warp will be wrong -> blur), grey = healthy motion.
+    bool  dbg = flowScale > 3.5;   // sentinel reachable within the [0.05,4.0] conf clamp
+    float fs  = dbg ? 1.0 : flowScale;
+
+    // Flow fields at this output pixel (px -> uv), scaled for tuning.
+    vec4 sBwd = texture(uFlowBwd, uv);            // F01 prev->curr
+    vec4 sFwd = texture(uFlowFwd, uv);            // F10 curr->prev
+    vec2 F01  = sBwd.xy * fs * invDim;
+    vec2 F10  = sFwd.xy * fs * invDim;
+    float cf01 = clamp(sBwd.w, 0.0, 1.0);         // front-end confidence
+    float cf10 = clamp(sFwd.w, 0.0, 1.0);
+
+    // Clamp flow magnitude. In low-texture regions (sky, grass, foliage) the SAD
+    // search locks onto spurious far-away matches; unclamped, those melt the whole
+    // frame. Cap displacement to a fraction of the screen so a wrong vector can only
+    // ever smear locally (and the photometric gate below then cross-fades it).
+    const float kMaxFlow = 0.10;                  // <=10% of screen
+    float m01 = length(F01); if (m01 > kMaxFlow) F01 *= kMaxFlow / m01;
+    float m10 = length(F10); if (m10 > kMaxFlow) F10 *= kMaxFlow / m10;
+
+    // ── Bidirectional backward-warp candidates ────────────────────────────────
+    vec2 pA = uv - alpha        * F01;            // sample point in I0
+    vec2 pB = uv - (1.0 - alpha) * F10;           // sample point in I1
+    vec3 C0 = texture(uPrev, pA).rgb;
+    vec3 C1 = texture(uCurr, pB).rgb;
+
+    // ── Importance Z_i = -(photometric residual + lambda * FB-inconsistency) ──
+    // Photometric (brightness constancy): warp the sample point across the pair
+    // by its own flow and measure luma disagreement. A good match -> ~0 residual
+    // -> high importance.
+    float eA = abs(luma(C0) - luma(texture(uCurr, pA + texture(uFlowBwd, pA).xy * flowScale * invDim).rgb));
+    float eB = abs(luma(C1) - luma(texture(uPrev, pB + texture(uFlowFwd, pB).xy * flowScale * invDim).rgb));
+
+    // FB-consistency: F01 and F10 should cancel where both are valid. Reuse the
+    // front-end confidence (m4 already gates on this) as the consistency term;
+    // fall back to a direct residual so model 3 (conf=1) still gets a signal.
+    vec2  fbUv = uv + F01;
+    float fbResid = length(F01 + texture(uFlowFwd, fbUv).xy * flowScale * invDim); // ~0 = consistent
+    float consist = min(cf01, cf10) * exp(-fbResid / (length(F01) + length(F10) + invDim.x));
+
+    float Z0 = -(photoScale * eA + lambda * (1.0 - consist));
+    float Z1 = -(photoScale * eB + lambda * (1.0 - consist));
+
+    // ── Softmax importance weights, biased by temporal proximity ──────────────
+    // tau: the temporally NEARER source frame is trusted more.
+    float tau0 = (1.0 - alpha);
+    float tau1 = alpha;
+    // shift by max(Z) for numerical stability (translation-invariance, as in the
+    // softmax-splatting importance metric).
+    float zmax = max(Z0, Z1);
+    float W0 = tau0 * exp(beta * (Z0 - zmax));
+    float W1 = tau1 * exp(beta * (Z1 - zmax));
+    float Wsum = W0 + W1;
+
+    vec3 warped = (Wsum > 1e-8) ? (W0 * C0 + W1 * C1) / Wsum
+                                : mix(C0, C1, alpha);
+
+    // ── Disocclusion fallback ────────────────────────────────────────────────
+    // When neither candidate is trustworthy (newly revealed content that no flow
+    // explains), degrade to a straight cross-fade of the untouched frames rather
+    // than smear along a wrong vector. This is the ghosting fix.
+    vec3 crossfade = mix(texture(uPrev, uv).rgb, texture(uCurr, uv).rgb, alpha);
+    // Photometric gate: if even the better of the two warps disagrees badly with
+    // the source pair (the flow is wrong here), distrust it and cross-fade. This is
+    // what stops the "melting" — model 3 writes confidence=1 so it had no gate at
+    // all; the warp residual now provides one for BOTH models.
+    // Cross-fade wherever the warp disagrees with the source pair. The flow field is
+    // noisy (small SAD blocks, upsampled from 1/4 res), so an over-loose gate lets
+    // wrong vectors warp -> the whole frame melts into an oil-painting smear (proven
+    // on device at flowScale>=1.0 + a loose gate). Keep this tight: warp only where
+    // the residual is genuinely small, cross-fade everything else. Blur-on-uncertainty
+    // is the safe failure; melt is not.
+    float photoErr   = min(eA, eB);
+    float photoTrust = 1.0 - smoothstep(0.04, 0.18, photoErr);
+    float trust = clamp(consist, 0.0, 1.0) * photoTrust;
+    trust *= smoothstep(0.0, epsilon, Wsum);      // both-unreliable -> 0
+
+    // ── Content-diff double-exposure fallback ─────────────────────────────────
+    // Video-analysis 2026-08-17 (Kratos hand-gesture melts at t=50/60/80):
+    // when the flow gate rejects a pixel AND prev+curr LOOK VERY DIFFERENT at
+    // that pixel (large object motion beyond flow reach — a hand that swept
+    // across 100+ px between two real frames at 24 fps), the crossfade above
+    // averages two totally different scenes = classic "two-hand double
+    // exposure" ghost. Snap to real curr in that case: lose the FG smoothness
+    // on those specific pixels for that frame, but no visible ghost. The rest
+    // of the frame keeps its interpolation. Soft switch so we don't create
+    // hard seams around moving edges.
+    vec3 prevC = texture(uPrev, uv).rgb;
+    vec3 currC = texture(uCurr, uv).rgb;
+    float contentDiff = length(currC - prevC);      // 0 = identical, ~1.7 = max diff
+    float untrusted   = 1.0 - smoothstep(0.10, 0.25, trust);   // 1 when trust < ~0.15
+    float bigDiff     = smoothstep(0.20, 0.40, contentDiff);    // 1 when diff > ~0.30
+    float snapToCurr  = untrusted * bigDiff;
+    crossfade = mix(crossfade, currC, snapToCurr);
+
+    vec3 outc = mix(crossfade, warped, trust);
+
+    // DEBUG flow visualiser (flowScale>5 sentinel): replace the generated frame with
+    // the raw solved flow so we can SEE its quality on device. black = static,
+    // green = healthy motion, red/yellow = flow saturating the 10% clamp (unreliable
+    // vectors -> the melt). If moving regions read red, the solver is the problem.
+    if (dbg) {
+        float mag = max(m01, m10);                    // screen-fraction (fs=1.0 in dbg)
+        float n   = clamp(mag / kMaxFlow, 0.0, 1.0);
+        float sat = step(kMaxFlow, mag);
+        imageStore(uOut, gid, vec4(sat, n, 0.0, 1.0));
+        return;
+    }
+
+    imageStore(uOut, gid, vec4(outc, 1.0));
+}
