+/* A whole multiplier is not required to fit EVERY source interval. At 114%
+ * speed a 29.26 ms source spans 1.756 slots of a 60 Hz display: keep the
+ * fractional slot, rather than rounding every interval down to one forever.
+ * Credits are presentation capacity, never simulation ticks. No debt or
+ * unused whole slots are banked, and a settings/refresh change resets phase. */
+typedef struct DrOpticalCadence { uint64_t fraction; unsigned refresh; int limit; } DrOpticalCadence;
+static inline int DrOpticalCadenceSteps(DrOpticalCadence *p,int limit,unsigned refresh,uint64_t span) {
+    if(limit<1)limit=1;
+    if(limit>4)limit=4;
+    if(!refresh)refresh=60000;
+    if(p->refresh!=refresh || p->limit!=limit){p->fraction=0;p->refresh=refresh;p->limit=limit;}
+    if(limit==1 || !span || span>250000000ull){p->fraction=0;return 1;}
+    uint64_t slots=span*(uint64_t)refresh+p->fraction;
+    int count=(int)(slots/1000000000000ull);
+    p->fraction=slots%1000000000000ull;
+    if(count<1)count=1;
+    return count>limit?limit:count;
+}
+static inline uint64_t DrOpticalCadenceSpan(uint64_t span,int steps,unsigned refresh) {
+    if(!refresh)refresh=60000;
+    uint64_t period=(1000000000000ull+refresh-1)/refresh;
+    uint64_t minimum=period*(uint64_t)(steps>0?steps:1);
+    return span<minimum?minimum:span;
+}
