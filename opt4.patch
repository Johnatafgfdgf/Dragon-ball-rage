+/* Image-only interpolation renders the scene ONCE per source tick. Its other
+   presentations have a separate cost; multiplying scene cost by N disables a
+   healthy 30 -> 60 path whenever the scene takes more than 16.7 ms. */
+typedef struct DrOpticalPolicy {
+    DrFramePolicy source;
+    uint64_t extraNs;
+} DrOpticalPolicy;
+static inline void DrOpticalPolicyExtra(DrOpticalPolicy *p, uint64_t ns) {
+    if (!ns) return;
+    if (ns > 100000000ull) ns = 100000000ull;
+    p->extraNs = p->extraNs ? (p->extraNs * 7 + ns) / 8 : ns;
+}
+static inline int DrOpticalPolicySample(DrOpticalPolicy *opt, uint64_t ns, uint64_t now,
+                                        uint64_t tickNs, int wanted, int thermal, int adaptive) {
+    DrFramePolicy *p = &opt->source;
+    int limit = wanted < 1 ? 1 : wanted > 4 ? 4 : wanted;
+    if (thermal >= 3) limit = 1;
+    else if (thermal >= 2 && limit > 2) limit = 2;
+    if (!p->cap) p->cap = limit;
+    if (p->cap > limit) { p->cap = limit; p->changedNs = now; p->goodSinceNs = 0; }
+    if (!adaptive) { p->cap = limit; return limit; }
+    if (!ns || !tickNs) { p->slow = 0; p->goodSinceNs = 0; return p->cap; }
+    if (ns > 100000000ull) ns = 100000000ull;
+    p->meanNs = p->meanNs ? (p->meanNs * 7 + ns) / 8 : ns;
+    if (++p->seen < 24) return p->cap;
+    uint64_t extra = opt->extraNs ? opt->extraNs : 1000000ull;
+    uint64_t budget = p->meanNs + extra * (uint64_t)(p->cap - 1);
+    if (budget > tickNs * 108 / 100) {
+        p->goodSinceNs = 0;
+        if (++p->slow >= 4 && p->cap > 1) {
+            p->cap = p->cap > 2 ? 2 : 1;
+            p->changedNs = now; p->slow = 0;
+        }
+    } else {
+        int next = p->cap == 1 ? 2 : p->cap + 1;
+        p->slow = 0;
+        /* A bounded 2x probe after sustained native headroom also recovers from
+           stale extra/VSync costs. Overload still backs off after four samples. */
+        int headroom = p->cap == 1 ? p->meanNs < tickNs * 85 / 100 :
+                       p->meanNs + extra * (uint64_t)(next - 1) < tickNs * 95 / 100;
+        if (next <= limit && headroom) {
+            if (!p->goodSinceNs) p->goodSinceNs = now;
+            if (now - p->goodSinceNs >= 3000000000ull && now - p->changedNs >= 3000000000ull) {
+                p->cap = next; p->changedNs = now; p->goodSinceNs = 0;
+            }
+        } else p->goodSinceNs = 0;
+    }
+    return p->cap;
+}
 static inline size_t DrCacheLimit(size_t base, int pressure) {
     return pressure >= 2 ? base / 2 : pressure == 1 ? base / 4 * 3 : base;
 }
